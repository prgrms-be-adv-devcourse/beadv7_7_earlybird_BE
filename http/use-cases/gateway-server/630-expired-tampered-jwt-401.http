### 630-expired-tampered-jwt-401.http — 만료/변조된 JWT로 접근 시 401
### https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/630
###
### NimbusReactiveJwtDecoder가 서명 검증 실패/만료된 토큰을 거부하는지 확인.
### 서명 변조는 이 파일에서 결정적으로 재현 가능(정상 토큰의 마지막 문자를 바꿔 서명을 깨뜨림).
### 만료 토큰은 실행 시점마다 새로 발급되는 access token이 아직 만료되지 않은 상태라 이 파일
### 안에서 결정적으로 재현할 수 없다 — jwt.access-token-expiration-seconds(config repo,
### user-service.yml)만큼 기다린 뒤 같은 accessToken으로 4번 요청을 다시 실행해서 확인할 것.

### 1. 회원가입
< {%
    client.global.set("userEmail", "uc630-" + Date.now() + "@earlybird.co.kr");
%}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!",
  "name": "유스케이스630",
  "phoneNumber": "010-1111-2222"
}

> {%
    client.test("회원가입 성공(200)", function() {
        client.assert(response.status === 200, "signup failed: " + response.body);
    });
%}

### 2. 로그인 (정상 access token 발급)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!"
}

> {%
    client.test("로그인 성공", function() {
        client.assert(response.status === 200, "login failed: " + response.body);
    });
    client.global.set("accessToken", response.body.data.accessToken);
    // 정상 토큰의 마지막 문자를 바꿔 서명을 깨뜨린다 (구조는 유지, 서명 검증만 실패해야 함)
    const token = response.body.data.accessToken;
    const lastChar = token.slice(-1);
    const tamperedChar = lastChar === "A" ? "B" : "A";
    client.global.set("tamperedToken", token.slice(0, -1) + tamperedChar);
%}

### 3. 서명이 변조된 토큰으로 보호된 경로 호출 — 401이어야 함
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{tamperedToken}}

> {%
    client.test("변조된 서명 토큰은 401", function() {
        client.assert(response.status === 401, "expected 401, got " + response.status + ": " + response.body);
    });
%}

### 4. (수동) 만료된 토큰으로 재요청 — access-token 만료시간만큼 기다린 뒤 이 요청만 다시 실행
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{accessToken}}

> {%
    client.test("[수동 검증용] 만료 후 재실행 시 401이어야 함 — 만료 전 실행이면 이 assertion은 의미 없음", function() {
        // 이 블록은 accessToken 발급 직후 자동 실행 파이프라인에서는 200이 정상이다.
        // 만료 시간 경과 후 사람이 직접 재실행했을 때만 401을 기대한다.
    });
%}
