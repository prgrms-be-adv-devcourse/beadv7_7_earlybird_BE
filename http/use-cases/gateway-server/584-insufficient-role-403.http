### 584-insufficient-role-403.http — 권한 부족 시 403 (역할 기반 인가)
### https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/584
###
### BACKER 역할 사용자가 ADMIN 전용 API(GET /api/v1/settlements/all)를 호출하면
### SecurityConfig의 hasRole(ADMIN) 규칙에 의해 403으로 차단되는지 확인.

### 1. 회원가입
< {%
    client.global.set("userEmail", "uc584-" + Date.now() + "@earlybird.co.kr");
%}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!",
  "name": "유스케이스584",
  "phoneNumber": "010-1111-2222"
}

> {%
    client.test("회원가입 성공(200)", function() {
        client.assert(response.status === 200, "signup failed: " + response.body);
    });
%}

### 2. 로그인 (BACKER role)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!"
}

> {%
    client.test("로그인 성공, BACKER role", function() {
        client.assert(response.status === 200, "login failed: " + response.body);
        client.assert(response.body.data.user.role === "BACKER", "unexpected role: " + response.body.data.user.role);
    });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 3. BACKER 토큰으로 ADMIN 전용 API 호출 — 403이어야 함
GET {{baseUrl}}/api/v1/settlements/all
Authorization: Bearer {{accessToken}}

> {%
    client.test("BACKER가 ADMIN 전용 API 호출 시 403", function() {
        client.assert(response.status === 403, "expected 403, got " + response.status + ": " + response.body);
    });
%}
