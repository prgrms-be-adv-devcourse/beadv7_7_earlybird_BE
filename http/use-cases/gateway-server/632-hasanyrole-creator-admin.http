### 632-hasanyrole-creator-admin.http — hasAnyRole(CREATOR, ADMIN) 둘 다 허용
### https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/632
###
### POST /api/v1/projects는 hasAnyRole(CREATOR, ADMIN)이다. CREATOR/ADMIN 둘 다 성공하고
### BACKER는 여전히 거부되는지 확인해 단일 hasRole과 구분되는 hasAnyRole 분기를 커버한다.
### role 전환은 발표용 즉시 전환 API(/me/role, #430)로 재로그인 없이 처리한다.

### 1. 회원가입
< {%
    client.global.set("userEmail", "uc632-" + Date.now() + "@earlybird.co.kr");
%}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!",
  "name": "유스케이스632",
  "phoneNumber": "010-1111-2222"
}

> {%
    client.test("회원가입 성공(200)", function() {
        client.assert(response.status === 200, "signup failed: " + response.body);
    });
%}

### 2. 로그인 (BACKER role)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!"
}

> {%
    client.test("로그인 성공", function() {
        client.assert(response.status === 200, "login failed: " + response.body);
    });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 3. 카테고리 목록 조회 (프로젝트 생성에 필요한 categoryId 확보)
GET {{baseUrl}}/api/v1/project-categories
Authorization: Bearer {{accessToken}}

> {%
    client.test("카테고리 목록 조회 성공", function() {
        client.assert(response.status === 200, "category list failed: " + response.body);
        client.assert(response.body.data.length > 0, "no categories found");
    });
    client.global.set("categoryId", response.body.data[0].id);
%}

### 4. BACKER 상태로 프로젝트 생성 시도 — 403이어야 함
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "유스케이스632 BACKER 시도",
  "categoryId": {{categoryId}},
  "summary": "hasAnyRole 검증",
  "description": "BACKER는 거부되어야 함",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("BACKER는 프로젝트 생성 403", function() {
        client.assert(response.status === 403, "expected 403, got " + response.status + ": " + response.body);
    });
%}

### 5. role을 CREATOR로 전환
POST {{baseUrl}}/api/v1/users/me/role
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "role": "CREATOR"
}

> {%
    client.test("CREATOR로 전환 성공", function() {
        client.assert(response.status === 200, "change role failed: " + response.body);
    });
    client.global.set("creatorToken", response.body.data.accessToken);
%}

### 6. CREATOR 토큰으로 프로젝트 생성 — 성공해야 함
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{creatorToken}}
Content-Type: application/json

{
  "title": "유스케이스632 CREATOR 시도",
  "categoryId": {{categoryId}},
  "summary": "hasAnyRole 검증",
  "description": "CREATOR는 성공해야 함",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("CREATOR는 프로젝트 생성 성공", function() {
        client.assert(response.status === 200, "expected 200, got " + response.status + ": " + response.body);
    });
%}

### 7. role을 ADMIN으로 전환
POST {{baseUrl}}/api/v1/users/me/role
Authorization: Bearer {{creatorToken}}
Content-Type: application/json

{
  "role": "ADMIN"
}

> {%
    client.test("ADMIN으로 전환 성공", function() {
        client.assert(response.status === 200, "change role failed: " + response.body);
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}

### 8. ADMIN 토큰으로 프로젝트 생성 — 성공해야 함
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "유스케이스632 ADMIN 시도",
  "categoryId": {{categoryId}},
  "summary": "hasAnyRole 검증",
  "description": "ADMIN도 성공해야 함",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("ADMIN도 프로젝트 생성 성공", function() {
        client.assert(response.status === 200, "expected 200, got " + response.status + ": " + response.body);
    });
%}
