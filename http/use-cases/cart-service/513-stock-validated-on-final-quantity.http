### 7. 리워드 등록 (totalQuantity=5 → remainingQuantity=5)
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name": "카트513 리워드", "description": "재고 5개 한정", "price": 1000, "totalQuantity": 5}

> {%
    client.test("리워드 등록 성공, remainingQuantity=5", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.remainingQuantity === 5, "expected remainingQuantity 5, got " + response.body.data.remainingQuantity);
    });
    client.global.set("rewardId", response.body.data.rewardId);
%}

