POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title": "카트513 재고검증 테스트", "categoryId": {{categoryId}}, "summary": "최종 수량 기준 재고 검증", "description": "513-stock-validated-on-final-quantity.http 로 생성", "goalAmount": 1000000, "startAt": "{{startAt}}", "endAt": "{{endAt}}"}

> {%
    client.test("프로젝트 등록 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("projectId", response.body.data.projectId);
