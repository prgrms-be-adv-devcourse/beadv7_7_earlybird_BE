### 536-internal-multi-item-removal.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/536
### CASE-22. 내부 다중 품목 삭제는 요청한 항목만 제거한다 (Order cleanup에서 사용하는 Cart 소유 내부 삭제)
###
### /internal/v1/** 는 게이트웨이 라우트가 없어(CLAUDE.md) cart-service 자신의 포트(:8085)로 직접
### 요청한다 — 로컬 전용, production 드롭다운으로는 실행 불가.

### 1. (게이트웨이 경유) 회원가입
< {% client.global.set("userEmail", "cart536-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!", "name": "카트536", "phoneNumber": "010-1111-0024"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!"}

> {%
    client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("userId", response.body.data.user.id);
%}

### 3. IN_PROGRESS 프로젝트에서 리워드 3개 이상 조회 (하나의 프로젝트에 리워드가 3개 미만이면
### 다른 projectId로 이 요청을 다시 실행)
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {%
    client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); });
    client.global.set("projectId", response.body.data[0].projectId);
%}

### 4. 리워드 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}

> {%
    client.test("리워드 3개 이상", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.length >= 3, "need at least 3 rewards on this project, got " + response.body.data.length);
    });
    client.global.set("rewardId1", response.body.data[0].rewardId);
    client.global.set("rewardId2", response.body.data[1].rewardId);
    client.global.set("rewardId3", response.body.data[2].rewardId);
%}

### 5. 세 리워드 모두 담기
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId1}}, "quantity": 1}, {"rewardId": {{rewardId2}}, "quantity": 1}, {"rewardId": {{rewardId3}}, "quantity": 1}]}

> {%
    client.test("세 리워드 담기 성공", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.itemCount === 3, "expected itemCount 3, got " + response.body.data.itemCount);
    });
%}

### 6. (cart-service 직접, 로컬 전용) Reward1, Reward3만 내부 삭제 요청
< {%
    request.variables.set("rewardId1", client.global.get("rewardId1"));
    request.variables.set("rewardId3", client.global.get("rewardId3"));
%}
DELETE http://localhost:8085/internal/v1/carts/users/{{userId}}/items
Content-Type: application/json

{"rewardIds": [{{rewardId1}}, {{rewardId3}}]}

> {% client.test("내부 다중 삭제 성공(200, body 없음)", function() { client.assert(response.status === 200, "expected 200, got " + response.status + ": " + response.body); }); %}

### 7. (게이트웨이 경유) 재조회 — Reward2만 남아있어야 한다
GET {{baseUrl}}/api/v1/carts
Authorization: Bearer {{accessToken}}

> {%
    client.test("Reward2만 남고 나머지는 삭제됨", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.itemCount === 1, "expected itemCount 1, got " + response.body.data.itemCount);
        const rewards = response.body.data.projects[0].rewards;
        client.assert(rewards.length === 1 && String(rewards[0].rewardId) === String(client.global.get("rewardId2")),
            "expected only reward2 to remain");
    });
%}
