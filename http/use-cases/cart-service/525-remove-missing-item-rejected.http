### 525-remove-missing-item-rejected.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/525
### CASE-18. 없는 품목 삭제 또는 없는 Cart에서의 삭제는 거부한다 (외부 단일 품목 삭제는 멱등적이지 않음)
###
### 환경: http-client.env.json 의 local/production. 위에서부터 순서대로 실행.

### --- 사용자 A: Cart는 있지만 대상 Reward가 없는 경우 (400) ---

### 1. 사용자 A 회원가입
< {% client.global.set("userAEmail", "cart525a-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userAEmail}}", "password": "rawPassword1!", "name": "카트525A", "phoneNumber": "010-1111-0018"}

> {% client.test("사용자 A 회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 사용자 A 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userAEmail}}", "password": "rawPassword1!"}

> {%
    client.test("사용자 A 로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessTokenA", response.body.data.accessToken);
%}

### 3. 사용자 A: IN_PROGRESS 프로젝트/리워드 조회
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessTokenA}}

> {%
    client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); });
    client.global.set("projectId", response.body.data[0].projectId);
%}

### 4. 사용자 A: 리워드 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessTokenA}}

> {%
    client.test("리워드 1건 이상", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); });
    client.global.set("rewardId", response.body.data[0].rewardId);
%}

### 5. 사용자 A: Cart는 만들되(Reward1만 담기) Reward가 없는 임의 ID(999999)는 담지 않는다
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessTokenA}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId}}, "quantity": 1}]}

> {% client.test("사용자 A Cart 생성 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 6. 사용자 A: 존재하지 않는 Cart 품목(999999) 삭제 시도 → 400
DELETE {{baseUrl}}/api/v1/carts/items/999999
Authorization: Bearer {{accessTokenA}}

> {%
    client.test("Cart는 있지만 없는 품목 삭제는 400", function() {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
    });
%}

### --- 사용자 B: Cart 자체가 없는 경우 (404) ---

### 7. 사용자 B 회원가입 (Cart를 한 번도 만들지 않은 신규 사용자)
< {% client.global.set("userBEmail", "cart525b-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userBEmail}}", "password": "rawPassword1!", "name": "카트525B", "phoneNumber": "010-1111-0019"}

> {% client.test("사용자 B 회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 8. 사용자 B 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userBEmail}}", "password": "rawPassword1!"}

> {%
    client.test("사용자 B 로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessTokenB", response.body.data.accessToken);
%}

### 9. 사용자 B: Cart 자체가 없는 상태에서 삭제 시도 → 404
DELETE {{baseUrl}}/api/v1/carts/items/999999
Authorization: Bearer {{accessTokenB}}

> {%
    client.test("Cart가 없는 사용자의 삭제는 404", function() {
        client.assert(response.status === 404, "expected 404, got " + response.status + ": " + response.body);
    });
%}
