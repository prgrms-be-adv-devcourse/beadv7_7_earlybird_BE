### 522-remove-single-item.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/522
### CASE-17. 기존 Cart 품목 하나를 제거한다 (다른 품목에 영향 없음, orphan deletion)
###
### 환경: http-client.env.json 의 local/production. 위에서부터 순서대로 실행.

### 1. 회원가입
< {% client.global.set("userEmail", "cart522-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!", "name": "카트522", "phoneNumber": "010-1111-0017"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!"}

> {%
    client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 3. 리워드 2개 이상인 IN_PROGRESS 프로젝트 조회
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {%
    client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); });
    client.global.set("projectId", response.body.data[0].projectId);
%}

### 4. 리워드 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}

> {%
    client.test("리워드 2개 이상", function() { client.assert(response.status === 200 && response.body.data.length >= 2, response.body); });
    client.global.set("rewardId1", response.body.data[0].rewardId);
    client.global.set("rewardId2", response.body.data[1].rewardId);
%}

### 5. 두 리워드 모두 담기
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId1}}, "quantity": 1}, {"rewardId": {{rewardId2}}, "quantity": 1}]}

> {% client.test("두 리워드 담기 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 6. Reward1만 삭제
DELETE {{baseUrl}}/api/v1/carts/items/{{rewardId1}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Reward1 삭제 성공, Reward2는 유지", function() {
        client.assert(response.status === 200, response.body);
        const rewards = response.body.data.projects[0].rewards;
        const has1 = rewards.some(r => String(r.rewardId) === String(client.global.get("rewardId1")));
        const has2 = rewards.some(r => String(r.rewardId) === String(client.global.get("rewardId2")));
        client.assert(!has1, "reward1 should have been removed");
        client.assert(has2, "reward2 should remain untouched");
        client.assert(response.body.data.itemCount === 1, "expected itemCount 1, got " + response.body.data.itemCount);
    });
%}
