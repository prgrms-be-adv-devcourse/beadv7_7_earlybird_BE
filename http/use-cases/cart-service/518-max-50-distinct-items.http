### 60. 첫 50개 리워드를 한 번에 Cart에 담는다 — 정확히 경계까지는 성공해야 한다
< {%
    const ids = client.global.get("rewardIdCsv").split(",").filter(Boolean).map(Number);
    client.global.set("first50", ids.slice(0, 50));
    client.global.set("reward51", ids[50]);
    const items = ids.slice(0, 50).map(id => ({ rewardId: id, quantity: 1 }));
    request.variables.set("itemsJson", JSON.stringify(items));
%}
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "items": {{itemsJson}}
}

> {%
    client.test("50개 distinct reward 추가 성공", function() {
        client.assert(response.status === 200, "adding 50 distinct rewards failed: " + response.body);
        client.assert(response.body.data.itemCount === 50, "itemCount should be 50, got " + response.body.data.itemCount);
    });
%}

### 61. 51번째로 서로 다른 리워드를 추가하면 거부되어야 한다
< {%
    request.variables.set("reward51", client.global.get("reward51"));
%}
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "items": [{"rewardId": {{reward51}}, "quantity": 1}]
}

> {%
    client.test("51번째 distinct reward 추가는 409로 거부됨", function() {
        client.assert(response.status === 409, "expected 409 for 51st distinct reward, got " + response.status + ": " + response.body);
    });
%}

### 62. Cart는 여전히 정확히 50개 품목이어야 한다
GET {{baseUrl}}/api/v1/carts
Authorization: Bearer {{accessToken}}

> {%
    client.test("Cart 품목 수는 50 유지", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.itemCount === 50, "itemCount should stay 50, got " + response.body.data.itemCount);
    });
%}
