### 499-add-first-reward-no-stock-reservation.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/499
### CASE-02. 빈 Cart에 주문 가능한 Reward 하나를 추가한다 — 추가는 재고를 예약하지 않는다
###
### 환경: http-client.env.json 의 local/production. 위에서부터 순서대로 실행.

### 1. 회원가입
< {%
    client.global.set("userEmail", "cart499-" + Date.now() + "@earlybird.co.kr");
%}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!",
  "name": "카트499",
  "phoneNumber": "010-1111-0002"
}

> {%
    client.test("회원가입 성공(200)", function() { client.assert(response.status === 200, response.body); });
%}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!"
}

> {%
    client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 3. 진행중인 프로젝트 목록 조회 — 시드 데이터 기준 IN_PROGRESS 프로젝트가 존재
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {%
    client.test("프로젝트 1건 이상 조회", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.length > 0, "no IN_PROGRESS projects");
    });
    client.global.set("projectId", response.body.data[0].projectId);
%}

### 4. 해당 프로젝트의 리워드 목록 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}

> {%
    client.test("리워드 1건 이상 조회", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.length > 0, "no rewards on this project");
    });
    client.global.set("rewardId", response.body.data[0].rewardId);
    client.global.set("remainingBefore", response.body.data[0].remainingQuantity);
%}

### 5. Cart에 리워드 추가 (POST) — 재고 예약이 아닌 검증만 수행하는지 확인
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "items": [{"rewardId": {{rewardId}}, "quantity": 2}]
}

> {%
    client.test("Cart 추가 성공, itemCount=1, quantity=2", function() {
        client.assert(response.status === 200, "add to cart failed: " + response.body);
        client.assert(response.body.data.itemCount === 1, "itemCount should be 1");
        const project = response.body.data.projects[0];
        const reward = project.rewards.find(r => String(r.rewardId) === String(client.global.get("rewardId")));
        client.assert(reward != null, "added reward not found in response");
        client.assert(reward.quantity === 2, "quantity should be 2");
    });
%}

### 6. 리워드 재고가 그대로인지 재조회로 확인 — Cart 추가는 재고를 차감하지 않는다
GET {{baseUrl}}/api/v1/rewards/{{rewardId}}

> {%
    client.test("remainingQuantity 불변", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.remainingQuantity === Number(client.global.get("remainingBefore")),
            "remainingQuantity changed after adding to cart: before=" + client.global.get("remainingBefore")
            + " after=" + response.body.data.remainingQuantity);
    });
%}
