### 11. Reward A(12000원) 2개 담기 → 소계 24000, 배송비 3000(<50000), 총액 27000
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardAId}}, "quantity": 2}]}

> {%
    client.test("소계 24000, 배송비 3000, 총액 27000 (무료배송 미달)", function() {
        client.assert(response.status === 200, response.body);
        const p = response.body.data.projects[0];
        client.assert(Number(p.itemsAmount) === 24000, "expected itemsAmount 24000, got " + p.itemsAmount);
        client.assert(Number(p.shippingFee) === 3000, "expected shippingFee 3000, got " + p.shippingFee);
        client.assert(Number(p.totalAmount) === 27000, "expected totalAmount 27000, got " + p.totalAmount);
        client.assert(Number(response.body.data.totalItemsAmount) === 24000, "totalItemsAmount mismatch");
        client.assert(Number(response.body.data.totalShippingFee) === 3000, "totalShippingFee mismatch");
        client.assert(Number(response.body.data.totalAmount) === 27000, "totalAmount mismatch");
    });
%}

### 12. Reward B(26000원) 1개 추가 → 소계 50000(24000+26000), 무료배송(0), 총액 50000
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardBId}}, "quantity": 1}]}

> {%
    client.test("소계 50000, 무료배송(0), 총액 50000", function() {
        client.assert(response.status === 200, response.body);
        const p = response.body.data.projects[0];
        client.assert(Number(p.itemsAmount) === 50000, "expected itemsAmount 50000, got " + p.itemsAmount);
        client.assert(Number(p.shippingFee) === 0, "expected free shipping (0), got " + p.shippingFee);
        client.assert(Number(p.totalAmount) === 50000, "expected totalAmount 50000, got " + p.totalAmount);
        client.assert(Number(response.body.data.totalItemsAmount) === 50000, "totalItemsAmount mismatch");
        client.assert(Number(response.body.data.totalShippingFee) === 0, "totalShippingFee mismatch");
        client.assert(Number(response.body.data.totalAmount) === 50000, "totalAmount mismatch");
    });
%}
