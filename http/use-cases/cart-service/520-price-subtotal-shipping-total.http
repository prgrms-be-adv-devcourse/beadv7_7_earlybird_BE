### 7. Reward A 등록 (가격 12000)
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name": "Reward A", "description": "12000원 리워드", "price": 12000, "totalQuantity": 100}

> {%
    client.test("Reward A 등록 성공, price=12000", function() {
        client.assert(response.status === 200, response.body);
        client.assert(Number(response.body.data.price) === 12000, "expected price 12000, got " + response.body.data.price);
    });
    client.global.set("rewardAId", response.body.data.rewardId);
%}

