### 514-non-orderable-reward-rejected.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/514
### CASE-11. 주문 불가능한 Reward 또는 Project는 거부한다 (Reward.orderable 스냅샷 기준)
### (CartService: "Reward is not orderable. rewardId={id}")
###
### 환경: http-client.env.json 의 local/production. 위에서부터 순서대로 실행.
### 관리자의 deactivate로 리워드를 명시적으로 orderable=false 상태로 만든다.

### 1. 창작자 회원가입
< {% client.global.set("creatorEmail", "cart514creator-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{creatorEmail}}", "password": "rawPassword1!", "name": "카트514창작자", "phoneNumber": "010-1111-0012"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{creatorEmail}}", "password": "rawPassword1!"}

> {%
    client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

### 3. 창작자 전환
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"bankCode": "88", "accountNumber": "110-514-000000", "accountHolder": "카트514창작자"}

> {% client.test("창작자 전환 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 4. 토큰 재발급
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{"refreshToken": "{{refreshToken}}"}

> {%
    client.test("토큰 재발급 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5. 카테고리 조회
GET {{baseUrl}}/api/v1/project-categories
Authorization: Bearer {{accessToken}}

> {%
    client.test("카테고리 1건 이상", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); });
    client.global.set("categoryId", response.body.data[0].id);
%}

### 6. 프로젝트 등록
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title": "카트514 주문불가 테스트", "categoryId": {{categoryId}}, "summary": "orderable=false 검증", "description": "514-non-orderable-reward-rejected.http 로 생성", "goalAmount": 1000000, "startAt": "{{startAt}}", "endAt": "{{endAt}}"}

> {%
    client.test("프로젝트 등록 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("projectId", response.body.data.projectId);
%}

### 7. 리워드 등록
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name": "카트514 리워드", "description": "곧 비활성화될 리워드", "price": 1000, "totalQuantity": 10}

> {%
    client.test("리워드 등록 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("rewardId", response.body.data.rewardId);
%}

### 8. 관리자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "admin@earlybird.co.kr", "password": "rawPassword3!"}

> {%
    client.test("관리자 로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

### 9. 관리자 승인 (프로젝트를 IN_PROGRESS로 — orderable 판단의 전제)
POST {{baseUrl}}/api/v1/projects/{{projectId}}/approve
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("승인 성공(IN_PROGRESS)", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.status === "IN_PROGRESS", response.body.data.status);
    });
%}

### 10. 관리자가 리워드를 비활성화 (active=false → orderable=false)
POST {{baseUrl}}/api/v1/rewards/{{rewardId}}/deactivate
Authorization: Bearer {{adminAccessToken}}

> {% client.test("비활성화 성공", function() { client.assert(response.status === 200 || response.status === 204, "deactivate failed: " + response.status + " " + response.body); }); %}

### 11. 비활성화 확인
GET {{baseUrl}}/api/v1/rewards/{{rewardId}}

> {%
    client.test("orderable=false 확인", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.orderable === false, "expected orderable=false, got " + response.body.data.orderable);
    });
%}

### 12. 이 리워드를 Cart에 담으면 거부되어야 한다
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId}}, "quantity": 1}]}

> {%
    client.test("orderable=false Reward는 409로 거부", function() {
        client.assert(response.status === 409, "expected 409, got " + response.status + ": " + response.body);
    });
%}

### 13. Cart에 해당 항목이 저장되지 않았어야 한다
GET {{baseUrl}}/api/v1/carts
Authorization: Bearer {{accessToken}}

> {%
    client.test("Cart는 비어있음", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.itemCount === 0, "expected empty cart, got itemCount=" + response.body.data.itemCount);
    });
%}
