### 528-clear-entire-cart.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/528
### CASE-19. 기존 Cart 전체를 비운다 (Cart aggregate는 유지, 자식 품목만 전부 삭제)
###
### 환경: http-client.env.json 의 local/production. 위에서부터 순서대로 실행.

### 1. 회원가입
< {% client.global.set("userEmail", "cart528-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!", "name": "카트528", "phoneNumber": "010-1111-0020"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!"}

> {%
    client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 3. 리워드 2개 이상인 IN_PROGRESS 프로젝트 조회
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {%
    client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); });
    client.global.set("projectId", response.body.data[0].projectId);
%}

### 4. 리워드 조회 및 여러 품목 담기
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}

> {%
    client.test("리워드 2개 이상", function() { client.assert(response.status === 200 && response.body.data.length >= 2, response.body); });
    client.global.set("rewardId1", response.body.data[0].rewardId);
    client.global.set("rewardId2", response.body.data[1].rewardId);
%}

### 5. 여러 품목 담기
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId1}}, "quantity": 1}, {"rewardId": {{rewardId2}}, "quantity": 2}]}

> {%
    client.test("여러 품목 담기 성공", function() {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.itemCount === 2, "expected itemCount 2");
    });
%}

### 6. Cart 전체 비우기
DELETE {{baseUrl}}/api/v1/carts
Authorization: Bearer {{accessToken}}

> {%
    client.test("Cart 전체 비우기 성공(200, body 없음)", function() {
        client.assert(response.status === 200, "expected 200, got " + response.status + ": " + response.body);
    });
%}

### 7. GET으로 재확인 — Cart 자체는 남아있고 모든 합계가 0이어야 한다
GET {{baseUrl}}/api/v1/carts
Authorization: Bearer {{accessToken}}

> {%
    client.test("동일 Cart가 빈 상태로 남음", function() {
        client.assert(response.status === 200, response.body);
        const data = response.body.data;
        client.assert(data.itemCount === 0, "expected itemCount 0, got " + data.itemCount);
        client.assert(data.items.length === 0, "items should be empty");
        client.assert(data.projects.length === 0, "projects should be empty");
        client.assert(Number(data.totalAmount) === 0, "totalAmount should be 0");
    });
%}
