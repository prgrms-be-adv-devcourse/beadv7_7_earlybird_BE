%}

### 9. 관리자가 amount=3으로 축소 (축소 후 총수량 12 >= 판매량 2) -> 200
PATCH {{baseUrl}}/api/v1/rewards/{{rewardId}}/quantity
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{ "amount": 3 }

> {%
    client.test("판매분 유지 축소 성공", function () {
        client.assert(response.status === 200, "decrease failed: " + response.body);
        client.assert(response.body.data.totalQuantity === 12, "unexpected totalQuantity: " + response.body.data.totalQuantity);
        client.assert(response.body.data.remainingQuantity === 10, "unexpected remainingQuantity: " + response.body.data.remainingQuantity);
    });
%}
