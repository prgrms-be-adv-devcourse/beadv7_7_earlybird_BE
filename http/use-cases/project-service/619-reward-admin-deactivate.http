%}

### 7~8. 관리자 승인 (공개)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "admin@earlybird.co.kr", "password": "rawPassword3!" }

> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectId}}/approve
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("프로젝트 공개 성공", function () { client.assert(response.status === 200, response.body); });
%}

### 9. 관리자가 리워드 비활성화
POST {{baseUrl}}/api/v1/rewards/{{rewardId}}/deactivate
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("비활성화 성공", function () { client.assert(response.status === 200, response.body); });
%}

### 10. 재조회 -> 레코드는 그대로 존재, active=false
GET {{baseUrl}}/api/v1/rewards/{{rewardId}}

> {%
    client.test("레코드 보존 + active:false", function () {
        client.assert(response.status === 200, "reward should still exist: " + response.body);
        client.assert(response.body.data.active === false, "expected active=false, got " + response.body.data.active);
    });
%}
