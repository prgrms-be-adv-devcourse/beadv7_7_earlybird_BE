### 603-project-approved-visible-in-autocomplete.http — issue #603
### CASE-08. (Project) 승인된 프로젝트는 제목 자동완성 결과에 노출된다

### 1~4. 창작자 계정 준비
< {% client.global.set("creatorEmail", "usecase603-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!", "name": "프로젝트603테스트", "phoneNumber": "010-1111-3333" }

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "프로젝트603테스트" }

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5. 카테고리 확보 + 6. 프로젝트 B 등록 (고유 prefix 제목)
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
    client.global.set("fullTitle", "autocomp" + Date.now() + " 프로젝트");
    client.global.set("titlePrefix", "autocomp");
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "{{fullTitle}}",
  "categoryId": {{categoryId}},
  "summary": "issue #603 검증용",
  "description": "issue #603",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 B 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectBId", response.body.data.projectId);
%}

### 7. 관리자 승인 -> IN_PROGRESS
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "admin@earlybird.co.kr", "password": "rawPassword3!" }

> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectBId}}/approve
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("승인 성공(IN_PROGRESS)", function () { client.assert(response.status === 200, response.body); });
%}

### 8. 제목 앞부분으로 자동완성 조회 -> {projectId: B_id, title} 포함
GET {{baseUrl}}/api/v1/projects/autocomplete?keyword={{titlePrefix}}

> {%
    client.test("자동완성 결과에 B 포함", function () {
        client.assert(response.status === 200, "autocomplete failed: " + response.body);
        const found = response.body.data.some(p => String(p.projectId) === String(client.global.get("projectBId")));
        client.assert(found, "project B not found in autocomplete results");
    });
%}
