### 610-reward-hard-delete-before-publish.http — issue #610
### CASE-05. (Reward) 공개 전 리워드는 창작자가 하드 삭제할 수 있다

### 1~4. 창작자 계정 준비
< {% client.global.set("creatorEmail", "usecase610-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!", "name": "리워드610테스트", "phoneNumber": "010-1111-3333" }

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "리워드610테스트" }

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5~7. 카테고리 확보, 프로젝트+리워드 등록 (공개 전)
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "usecase610 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "issue #610 검증용",
  "description": "issue #610",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectId", response.body.data.projectId);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "usecase610 리워드", "description": "issue #610", "price": 10000, "totalQuantity": 10 }

> {%
    client.test("리워드 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("rewardId", response.body.data.rewardId);
%}

### 8. 소유자가 리워드 하드 삭제
DELETE {{baseUrl}}/api/v1/rewards/{{rewardId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("삭제 성공", function () { client.assert(response.status === 200, response.body); });
%}

### 9. 삭제 확인 -> 재조회 404
GET {{baseUrl}}/api/v1/rewards/{{rewardId}}

> {%
    client.test("삭제된 리워드 재조회 -> 404", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
%}

### 10. 리워드 재등록 (totalQuantity=10) — 이후 611~620 케이스가 이어서 쓸 상태
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "usecase610 리워드-재등록", "description": "issue #610", "price": 10000, "totalQuantity": 10 }

> {%
    client.test("재등록 성공, 새 rewardId 발급", function () {
        client.assert(response.status === 200, response.body);
        client.assert(!!response.body.data.rewardId, "new rewardId missing");
    });
%}
