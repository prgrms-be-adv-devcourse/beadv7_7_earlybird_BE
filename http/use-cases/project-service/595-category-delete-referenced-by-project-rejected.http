### 595-category-delete-referenced-by-project-rejected.http — issue #595
### CASE-08. (Category) 프로젝트가 참조 중인 카테고리는 삭제가 거부된다

### 1. 관리자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "admin@earlybird.co.kr",
  "password": "rawPassword3!"
}

> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

### 2. 카테고리 A 등록 (parent 없음, 하위/참조 없음)
< {% client.global.set("catAName", "usecase595-A-" + Date.now()); %}
POST {{baseUrl}}/api/v1/project-categories
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{ "name": "{{catAName}}" }

> {%
    client.test("A 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("categoryAId", response.body.data.id);
%}

### 3. 창작자 계정 준비 — 회원가입 -> 로그인 -> 창작자 전환 -> 토큰 재발급
< {% client.global.set("creatorEmail", "usecase595-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{creatorEmail}}",
  "password": "rawPassword1!",
  "name": "카테고리595테스트",
  "phoneNumber": "010-1111-2222"
}

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

### 4. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{creatorEmail}}",
  "password": "rawPassword1!"
}

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

### 5. 창작자 전환
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "bankCode": "88",
  "accountNumber": "110-123-456789",
  "accountHolder": "카테고리595테스트"
}

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

### 6. 토큰 재발급 (role=CREATOR 반영)
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 7. categoryId=A로 프로젝트 등록
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "usecase595 카테고리 참조 테스트 프로젝트",
  "categoryId": {{categoryAId}},
  "summary": "카테고리 삭제 거부 검증용",
  "description": "issue #595",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 등록 성공(categoryId=A)", function () {
        client.assert(response.status === 200, "create project failed: " + response.body);
    });
%}

### 8. 프로젝트가 참조 중인 A 삭제 시도 -> 409
DELETE {{baseUrl}}/api/v1/project-categories/{{categoryAId}}
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("프로젝트가 참조 중 -> 삭제 거부(409)", function () {
        client.assert(response.status === 409, "expected 409, got " + response.status + ": " + response.body);
    });
%}
