### 596-project-register-pending-private.http — issue #596
### CASE-01. (Project) 프로젝트 등록 시 PENDING_REVIEW 상태이며 비공개다

### 1. 창작자(CREATOR1) 계정 준비
< {% client.global.set("creatorEmail", "usecase596-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{creatorEmail}}",
  "password": "rawPassword1!",
  "name": "프로젝트596테스트",
  "phoneNumber": "010-1111-3333"
}

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

### 3. 창작자 전환
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "프로젝트596테스트" }

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

### 4. 토큰 재발급 (role=CREATOR)
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5. 카테고리 목록 조회 (categoryId 확보)
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.test("카테고리 1건 이상", function () {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.length > 0, "no categories found — seed one first");
    });
    client.global.set("categoryId", response.body.data[0].id);
%}

### 6. 프로젝트 A 등록 — 고유 키워드 포함 제목
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
    client.global.set("uniqueTitle", "테스트유즈케이스596검색용프로젝트-" + Date.now());
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "{{uniqueTitle}}",
  "categoryId": {{categoryId}},
  "summary": "issue #596 검증용",
  "description": "issue #596",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 A 등록 -> PENDING_REVIEW", function () {
        client.assert(response.status === 200, "create project failed: " + response.body);
        client.assert(response.body.data.status === "PENDING_REVIEW", "unexpected status: " + response.body.data.status);
    });
    client.global.set("projectAId", response.body.data.projectId);
%}

### 7. 비로그인 사용자가 A를 조회 -> 비공개라 404
GET {{baseUrl}}/api/v1/projects/{{projectAId}}

> {%
    client.test("비로그인 조회 -> 404 (비공개)", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status + ": " + response.body);
    });
%}
