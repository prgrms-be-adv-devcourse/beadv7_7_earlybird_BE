### 607-reward-update-by-non-owner-rejected.http — issue #607
### CASE-02. (Reward) 본인 소유가 아닌 프로젝트의 리워드는 수정할 수 없다

### 1~4. 창작자1(소유자) 계정 준비
< {% client.global.set("creator1Email", "usecase607-owner-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creator1Email}}", "password": "rawPassword1!", "name": "리워드607소유자", "phoneNumber": "010-1111-3333" }

> {% client.test("회원가입 성공(소유자)", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creator1Email}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공(소유자)", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken1", response.body.data.accessToken);
    client.global.set("refreshToken1", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken1}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "리워드607소유자" }

> {% client.test("창작자1 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken1}}" }

> {%
    client.test("창작자1 토큰 재발급", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken1", response.body.data.accessToken);
%}

### 5~8. 창작자2(비소유자) 계정 준비
< {% client.global.set("creator2Email", "usecase607-other-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creator2Email}}", "password": "rawPassword1!", "name": "리워드607비소유자", "phoneNumber": "010-2222-4444" }

> {% client.test("회원가입 성공(비소유자)", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creator2Email}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공(비소유자)", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken2", response.body.data.accessToken);
    client.global.set("refreshToken2", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "220-987-654321", "accountHolder": "리워드607비소유자" }

> {% client.test("창작자2 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken2}}" }

> {%
    client.test("창작자2 토큰 재발급", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken2", response.body.data.accessToken);
%}

### 9~11. 카테고리 확보, 창작자1이 프로젝트+리워드 등록
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken1}}
Content-Type: application/json

{
  "title": "usecase607 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "issue #607 검증용",
  "description": "issue #607",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectId", response.body.data.projectId);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken1}}
Content-Type: application/json

{ "name": "usecase607 리워드", "description": "issue #607", "price": 10000, "totalQuantity": 10 }

> {%
    client.test("리워드 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("rewardId", response.body.data.rewardId);
%}

### 12. 창작자2(비소유자)가 리워드 수정 시도 -> 400
PATCH {{baseUrl}}/api/v1/rewards/{{rewardId}}
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{ "price": 99999 }

> {%
    client.test("비소유자 수정 -> 400", function () {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
    });
%}
