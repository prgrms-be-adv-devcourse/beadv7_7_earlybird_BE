%}

### 5. 카테고리 확보 + 6. 프로젝트 B 등록 (고유 키워드 포함)
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
    client.global.set("uniqueKeyword", "테스트유즈케이스605검색용키워드" + Date.now());
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "{{uniqueKeyword}} 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "issue #605 검증용",
  "description": "issue #605",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 B 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectBId", response.body.data.projectId);
%}

### 7. 관리자 승인 -> IN_PROGRESS (색인됨)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "admin@earlybird.co.kr", "password": "rawPassword3!" }

> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectBId}}/approve
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("승인 성공(IN_PROGRESS)", function () { client.assert(response.status === 200, response.body); });
%}

### 8. 소유자가 B 취소 -> CANCELLED
POST {{baseUrl}}/api/v1/projects/{{projectBId}}/cancel
Authorization: Bearer {{accessToken}}

> {%
    client.test("취소 성공(CANCELLED)", function () {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.status === "CANCELLED", response.body.data.status);
    });
%}

### 9. 비로그인 키워드 검색 -> B가 CANCELLED 상태로 검색 결과에 노출됨
GET {{baseUrl}}/api/v1/projects?keyword={{uniqueKeyword}}

> {%
    client.test("검색 결과에 B 포함되고 CANCELLED 상태로 노출됨", function () {
        client.assert(response.status === 200, "search failed: " + response.body);
        const b = response.body.data.find(p => String(p.projectId) === String(client.global.get("projectBId")));
        client.assert(!!b, "project B not found in search results");
        client.assert(b.status === "CANCELLED", "expected CANCELLED status, got: " + b?.status);
        client.assert(b.closed === true, "expected closed: true, got: " + b?.closed);
    });
%}
