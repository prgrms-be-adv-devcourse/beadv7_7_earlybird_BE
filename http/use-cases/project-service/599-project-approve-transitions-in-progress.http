### 599-project-approve-transitions-in-progress.http — issue #599
### CASE-04. (Project) 관리자가 승인하면 IN_PROGRESS로 전이된다
### 이 파일이 만드는 프로젝트 B는 600/601/602/603/604/605 파일에서도 각자 독립적으로 새로 만든다
### (각 파일은 서로 의존하지 않고 단독 실행 가능하도록 설계됨).

### 1~4. 창작자(CREATOR1) 계정 준비
< {% client.global.set("creatorEmail", "usecase599-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!", "name": "프로젝트599테스트", "phoneNumber": "010-1111-3333" }

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "프로젝트599테스트" }

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5. 카테고리 확보
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

### 6. 프로젝트 B 등록 (고유 키워드 포함 제목)
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
    client.global.set("uniqueTitle", "테스트유즈케이스599검색용프로젝트-" + Date.now());
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "{{uniqueTitle}}",
  "categoryId": {{categoryId}},
  "summary": "issue #599 검증용",
  "description": "issue #599",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 B 등록 -> PENDING_REVIEW", function () {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.status === "PENDING_REVIEW", response.body.data.status);
    });
    client.global.set("projectBId", response.body.data.projectId);
%}

### 7. 관리자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "admin@earlybird.co.kr", "password": "rawPassword3!" }

> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

### 8. 관리자가 B 승인
POST {{baseUrl}}/api/v1/projects/{{projectBId}}/approve
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("승인 성공", function () { client.assert(response.status === 200, response.body); });
%}

### 9. 재조회 -> IN_PROGRESS
GET {{baseUrl}}/api/v1/projects/{{projectBId}}

> {%
    client.test("재조회 시 IN_PROGRESS", function () {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.status === "IN_PROGRESS", "unexpected status: " + response.body.data.status);
    });
%}
