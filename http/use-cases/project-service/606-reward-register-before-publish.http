### 606-reward-register-before-publish.http — issue #606
### CASE-01. (Reward) 공개 전 프로젝트에 리워드를 정상 등록할 수 있다

### 1~4. 창작자1(프로젝트 소유자) 계정 준비
< {% client.global.set("creatorEmail", "usecase606-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!", "name": "리워드606테스트", "phoneNumber": "010-1111-3333" }

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "리워드606테스트" }

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5. 카테고리 확보 + 6. 프로젝트 등록 (PENDING_REVIEW, 공개 전)
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "usecase606 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "issue #606 검증용",
  "description": "issue #606",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 등록 성공(PENDING_REVIEW)", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectId", response.body.data.projectId);
%}

### 7. 리워드 등록 — totalQuantity=10
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "usecase606 리워드",
  "description": "issue #606",
  "price": 10000,
  "totalQuantity": 10
}

> {%
    client.test("리워드 등록 성공, 수량 10", function () {
        client.assert(response.status === 200, "register reward failed: " + response.body);
        client.assert(!!response.body.data.rewardId, "rewardId missing");
        client.assert(response.body.data.totalQuantity === 10, "unexpected totalQuantity: " + response.body.data.totalQuantity);
        client.assert(response.body.data.remainingQuantity === 10, "unexpected remainingQuantity: " + response.body.data.remainingQuantity);
    });
%}
