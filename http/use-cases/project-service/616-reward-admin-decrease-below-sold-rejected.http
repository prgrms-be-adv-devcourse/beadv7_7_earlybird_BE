### 616-reward-admin-decrease-below-sold-rejected.http — issue #616
### CASE-11. (Reward) 이미 판매된 수량보다 적은 총수량으로는 축소할 수 없다
###
### 판매량(soldQuantity)을 만들려면 재고 차감이 먼저 일어나야 한다 — /internal/v1/**는
### 게이트웨이 라우팅이 없어(CLAUDE.md) local(http://localhost:8081)에서만 직접 호출 가능하다.
### production에서는 7번(재고 차감) 단계를 건너뛰고 이미 판매 이력이 있는 실제 리워드로
### 대체해서 검증한다.

### 1~4. 창작자 계정 준비
< {% client.global.set("creatorEmail", "usecase616-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!", "name": "리워드616테스트", "phoneNumber": "010-1111-3333" }

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "리워드616테스트" }

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5~6. 카테고리 확보, 프로젝트+리워드(totalQuantity=15) 등록
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "usecase616 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "issue #616 검증용",
  "description": "issue #616",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectId", response.body.data.projectId);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "usecase616 리워드", "description": "issue #616", "price": 10000, "totalQuantity": 15 }

> {%
    client.test("리워드 등록 성공, 수량 15", function () { client.assert(response.status === 200, response.body); });
    client.global.set("rewardId", response.body.data.rewardId);
%}

### 7. [로컬 전용] 판매량 2 확보 — 재고 2 차감 (totalQuantity=15, remainingQuantity=13, 판매량=2)
POST http://localhost:8081/internal/v1/rewards/{{rewardId}}/decrease-stock
Content-Type: application/json

{ "quantity": 2, "orderId": 1001 }

> {%
    client.test("판매량 확보용 차감 성공", function () { client.assert(response.status === 200, response.body); });
%}

### 8. 관리자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "admin@earlybird.co.kr", "password": "rawPassword3!" }

> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

### 9. 관리자가 amount=14로 축소 시도 (축소 후 총수량 1 < 판매량 2) -> 400
PATCH {{baseUrl}}/api/v1/rewards/{{rewardId}}/quantity
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{ "amount": 14 }

> {%
    client.test("판매량 미만 축소 -> 400", function () {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
    });
%}
