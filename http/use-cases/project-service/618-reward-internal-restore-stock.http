### 618-reward-internal-restore-stock.http — issue #618
### CASE-13. (Reward) 주문 취소 시 내부 API 호출로 차감된 재고가 복원된다
###
### /internal/v1/**는 게이트웨이 라우팅이 없어 local(http://localhost:8081) 전용 —
### production에서는 이 파일의 내부 API 단계들을 건너뛴다.

### 1~4. 창작자 계정 준비
< {% client.global.set("creatorEmail", "usecase618-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!", "name": "리워드618테스트", "phoneNumber": "010-1111-3333" }

> {% client.test("회원가입 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "{{creatorEmail}}", "password": "rawPassword1!" }

> {%
    client.test("로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

###
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "bankCode": "88", "accountNumber": "110-123-456789", "accountHolder": "리워드618테스트" }

> {% client.test("창작자 전환 성공", function () { client.assert(response.status === 200, response.body); }); %}

###
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.test("토큰 재발급 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 5~6. 카테고리 확보, 프로젝트+리워드(totalQuantity=12) 등록
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "usecase618 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "issue #618 검증용",
  "description": "issue #618",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectId", response.body.data.projectId);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "usecase618 리워드", "description": "issue #618", "price": 10000, "totalQuantity": 12 }

> {%
    client.test("리워드 등록 성공, 수량 12", function () { client.assert(response.status === 200, response.body); });
    client.global.set("rewardId", response.body.data.rewardId);
%}

### 7. [로컬 전용] 2개 판매(차감) — remainingQuantity 12 -> 10
POST http://localhost:8081/internal/v1/rewards/{{rewardId}}/decrease-stock
Content-Type: application/json

{ "quantity": 2, "orderId": 1001 }

> {%
    client.test("차감 성공", function () {
        client.assert(response.status === 200, response.body);
    });
%}

### 8. [로컬 전용] 동일 orderId(1001)로 재고 복원 (주문 취소 시나리오)
POST http://localhost:8081/internal/v1/rewards/{{rewardId}}/restore-stock
Content-Type: application/json

{ "quantity": 2, "orderId": 1001 }

> {%
    client.test("복원 성공", function () { client.assert(response.status === 200, response.body); });
%}

### 9. 재조회 -> remainingQuantity == totalQuantity == 12 (판매분 0으로 복원)
GET {{baseUrl}}/api/v1/rewards/{{rewardId}}

> {%
    client.test("판매분 완전 복원 확인", function () {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.remainingQuantity === 12, "unexpected remainingQuantity: " + response.body.data.remainingQuantity);
        client.assert(response.body.data.totalQuantity === 12, "unexpected totalQuantity: " + response.body.data.totalQuantity);
    });
%}
