### 9. 카테고리 확보 + 10. 창작자1이 프로젝트 B 등록
GET {{baseUrl}}/api/v1/project-categories

> {%
    client.assert(response.body.data.length > 0, "no categories found");
    client.global.set("categoryId", response.body.data[0].id);
%}

###
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken1}}
Content-Type: application/json

{
  "title": "usecase601 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "issue #601 검증용",
  "description": "issue #601",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.test("프로젝트 B 등록 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("projectBId", response.body.data.projectId);
%}

### 11. 관리자 승인 -> IN_PROGRESS
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{ "email": "admin@earlybird.co.kr", "password": "rawPassword3!" }

> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectBId}}/approve
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("승인 성공(IN_PROGRESS)", function () {
        client.assert(response.status === 200, response.body);
        client.assert(response.body.data.status === "IN_PROGRESS", response.body.data.status);
    });
%}

### 12. 창작자2(비소유자)가 B를 취소 시도 -> 400
POST {{baseUrl}}/api/v1/projects/{{projectBId}}/cancel
Authorization: Bearer {{accessToken2}}

> {%
    client.test("비소유자 취소 -> 400", function () {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
    });
%}
