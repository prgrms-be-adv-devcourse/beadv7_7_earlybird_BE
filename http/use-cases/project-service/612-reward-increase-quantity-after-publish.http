> {%
    client.test("관리자 로그인 성공", function () { client.assert(response.status === 200, response.body); });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

###
POST {{baseUrl}}/api/v1/projects/{{projectId}}/approve
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("프로젝트 공개 성공(IN_PROGRESS)", function () { client.assert(response.status === 200, response.body); });
%}

### 10. increaseQuantity=5만 지정해 수량 증가
PATCH {{baseUrl}}/api/v1/rewards/{{rewardId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "increaseQuantity": 5 }

> {%
    client.test("수량 10 -> 15 증가", function () {
        client.assert(response.status === 200, "increase failed: " + response.body);
        client.assert(response.body.data.totalQuantity === 15, "unexpected totalQuantity: " + response.body.data.totalQuantity);
        client.assert(response.body.data.remainingQuantity === 15, "unexpected remainingQuantity: " + response.body.data.remainingQuantity);
    });
%}
