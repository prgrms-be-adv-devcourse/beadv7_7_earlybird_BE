### 1단계 시나리오: Cart에 Project A의 Reward 101만 담는다
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectIdA}}, "items": [{"rewardId": {{reward101}}, "quantity": 1}]}

> {% client.assert(response.status === 200, "add to cart failed"); %}

### 1단계: projectId를 B로 잘못 지정해 주문 -> 400 (Cart 내용은 A인데 요청 projectId는 B)
< {% request.variables.set("k1", crypto.randomUUID()); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectIdB}},
  "requests": [{"rewardId": {{reward101}}, "quantity": 1, "expectedUnitPrice": 10000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 10000, "expectedTotalAmount": 13000,
  "orderIdempotencyKey": "{{k1}}"
}

> {%
    client.test("잘못된 projectId 지정 -> 400", function() {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
        client.assert(JSON.stringify(response.body).includes("Order project does not match Cart rewards"), "unexpected message: " + response.body);
    });
%}

### 2단계 시나리오: 같은 Cart에 Project B의 Reward 201도 추가 담아 두 프로젝트가 섞인 Cart를 만든다
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectIdB}}, "items": [{"rewardId": {{reward201}}, "quantity": 1}]}

> {% client.assert(response.status === 200, "add to cart failed: " + response.body); %}

### 2단계: Cart의 두 Reward와 정확히 일치하는 요청을 보내되 projectId는 생략(null) -> 409 (Cart가 여러 프로젝트에 걸쳐있음)
< {% request.variables.set("k2", crypto.randomUUID()); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}},
  "requests": [
    {"rewardId": {{reward101}}, "quantity": 1, "expectedUnitPrice": 10000},
    {"rewardId": {{reward201}}, "quantity": 1, "expectedUnitPrice": 10000}
  ],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 20000, "expectedTotalAmount": 23000,
  "orderIdempotencyKey": "{{k2}}"
}

> {%
    client.test("다중 Project Cart -> 409", function() {
        client.assert(response.status === 409, "expected 409, got " + response.status + ": " + response.body);
        client.assert(JSON.stringify(response.body).includes("Cart contains rewards from multiple projects"), "unexpected message: " + response.body);
    });
%}
