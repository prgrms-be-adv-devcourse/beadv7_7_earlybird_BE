### 1차 요청 — 새 키로 정상 주문 생성 (PAID)
< {% client.global.set("sharedKey", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 12000, "expectedTotalAmount": 15000,
  "orderIdempotencyKey": "{{sharedKey}}"
}

> {%
    client.assert(response.status === 200, "first place order failed: " + response.body);
    client.global.set("firstOrderId", response.body.data.id);
%}

### 다시 담기 — 두 번째 호출 시점엔 Cart가 비어있으므로(주문 성공 시 정리됨) 다시 채워서
### "같은 키로 재요청"이라는 전제를 재현한다. body 값은 이슈 설명대로 달라도 무방함을 보이기 위해 수량을 바꿔 담는다.
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId}}, "quantity": 3}]}

> {% client.assert(response.status === 200, "re-add to cart failed"); %}

### 2차 요청 — 같은 orderIdempotencyKey, 다른 body(수량/금액)로 재호출 -> 기존 Order를 그대로 반환해야 한다
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 3, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 36000, "expectedTotalAmount": 39000,
  "orderIdempotencyKey": "{{sharedKey}}"
}

> {%
    client.test("같은 키 재요청 -> 기존 Order 그대로 반환", function() {
        client.assert(response.status === 200, "second place order failed: " + response.body);
        client.assert(String(response.body.data.id) === String(client.global.get("firstOrderId")), "expected same order id, got " + response.body.data.id);
        client.assert(response.body.data.itemsAmount === 12000, "should keep original amount (12000), not new body's 36000 — got " + response.body.data.itemsAmount);
    });
%}
