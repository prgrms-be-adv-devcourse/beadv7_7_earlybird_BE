{"title": "541 Cart 일치 검증", "categoryId": {{categoryId}}, "summary": "CASE-03", "description": "541-order-items-must-match-cart.http", "goalAmount": 1000000, "startAt": "{{startAt}}", "endAt": "{{endAt}}"}

> {% client.global.set("projectId", response.body.data.projectId); %}

