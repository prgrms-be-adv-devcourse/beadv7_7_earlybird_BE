### 14. Cart에는 정확히 Reward 101, 102만 담는다
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{reward101}}, "quantity": 1}, {"rewardId": {{reward102}}, "quantity": 1}]}

> {% client.assert(response.status === 200, "add to cart failed"); %}

### 15. 부분집합(Reward 101만) 주문 시도 -> 400
< {% request.variables.set("k1", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{reward101}}, "quantity": 1, "expectedUnitPrice": 10000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 10000, "expectedTotalAmount": 13000,
  "orderIdempotencyKey": "{{k1}}"
}

> {%
    client.test("Cart 부분집합 주문 -> 400", function() {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
        client.assert(JSON.stringify(response.body).includes("Order items must match the current Cart"), "unexpected message: " + response.body);
    });
%}

### 16. 초집합(101,102,103) 주문 시도 -> 400
< {% request.variables.set("k2", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [
    {"rewardId": {{reward101}}, "quantity": 1, "expectedUnitPrice": 10000},
    {"rewardId": {{reward102}}, "quantity": 1, "expectedUnitPrice": 10000},
    {"rewardId": {{reward103}}, "quantity": 1, "expectedUnitPrice": 10000}
  ],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 30000, "expectedTotalAmount": 33000,
  "orderIdempotencyKey": "{{k2}}"
}

> {%
    client.test("Cart 초집합 주문 -> 400", function() {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
        client.assert(JSON.stringify(response.body).includes("Order items must match the current Cart"), "unexpected message: " + response.body);
    });
%}

### 17. 두 시도 모두 실패했으므로 Cart는 그대로 (101,102 유지) 확인
GET {{baseUrl}}/api/v1/carts
Authorization: Bearer {{backerAccessToken}}

> {%
    client.test("Cart 변경 없음 (여전히 2개)", function() {
        client.assert(response.body.data.itemCount === 2, "cart item count changed: " + JSON.stringify(response.body.data));
    });
%}
