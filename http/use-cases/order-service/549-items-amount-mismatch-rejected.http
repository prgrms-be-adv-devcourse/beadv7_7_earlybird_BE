### 수량 2, 단가 12000 -> 실제 상품합계는 24000이어야 하는데 expectedItemsAmount를 23000으로 틀리게 보낸다
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId}}, "quantity": 2}]}

> {% client.assert(response.status === 200, "add to cart failed"); %}

###
< {% request.variables.set("orderIdempotencyKey", crypto.randomUUID()); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 2, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 23000, "expectedTotalAmount": 27000,
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.test("itemsAmount 불일치 -> 400", function() {
        client.assert(response.status === 400, "expected 400, got " + response.status + ": " + response.body);
        client.assert(JSON.stringify(response.body).includes("Invalid order amount"), "unexpected message: " + response.body);
    });
%}

