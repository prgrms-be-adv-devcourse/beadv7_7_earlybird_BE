### === 동시 요청 A — 이 요청과 바로 아래 B를, 새 탭 2개를 열어 거의 동시에 실행(Ctrl+Enter)한다 ===
< {% client.global.set("raceKey", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 12000, "expectedTotalAmount": 15000,
  "orderIdempotencyKey": "{{raceKey}}"
}

> {%
    client.test("요청 A 성공, PAID", function() {
        client.assert(response.status === 200, "place order A failed: " + response.body);
    });
    client.global.set("orderIdA", response.body.data.id);
%}

### === 동시 요청 B (같은 사용자/같은 키/같은 body) — A와 거의 동시에 실행할 것 ===
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 12000, "expectedTotalAmount": 15000,
  "orderIdempotencyKey": "{{raceKey}}"
}

> {%
    client.test("요청 B도 같은 Order를 반환 (둘 다 성공, 같은 order id)", function() {
        client.assert(response.status === 200, "place order B failed: " + response.body);
        client.assert(String(response.body.data.id) === String(client.global.get("orderIdA")), "A/B order id mismatch — race condition may not have occurred (순차 실행됨), 두 요청을 실제로 동시에 실행했는지 확인");
    });
%}

### 순차 실행되어 위 검증이 의미 없어졌더라도, 아래로 (user_id, orderIdempotencyKey) 조합의 주문이
### 정확히 1건인지는 내 후원 내역으로 항상 확인 가능하다.
GET {{baseUrl}}/api/v1/orders/me?userId={{userId}}
Authorization: Bearer {{backerAccessToken}}

> {%
    client.test("동일 키로 생성된 Order는 정확히 1건", function() {
        const matches = response.body.data.filter(o => String(o.id) === String(client.global.get("orderIdA")));
        client.assert(matches.length === 1, "expected exactly 1 order for this key, got " + matches.length);
    });
%}
