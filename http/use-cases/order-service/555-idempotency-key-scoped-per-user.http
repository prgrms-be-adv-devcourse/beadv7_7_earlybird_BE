### 사용자 2 — 사용자 1과 완전히 같은 키로 주문 -> user_id가 다르므로 별도 Order 생성
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backer2Token}}
Content-Type: application/json

{
  "userId": {{userId2}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": 12000}],
  "receiverName": "Kim2", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 12000, "expectedTotalAmount": 15000,
  "orderIdempotencyKey": "{{sharedKey}}"
}

> {%
    client.test("동일 키라도 사용자가 다르면 별도 Order 생성", function() {
        client.assert(response.status === 200, "user2 place order failed: " + response.body);
        client.assert(String(response.body.data.id) !== String(client.global.get("order1Id")), "user2 order id should differ from user1's, got same: " + response.body.data.id);
    });
%}
