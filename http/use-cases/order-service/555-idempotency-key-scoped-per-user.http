< {% client.global.set("sharedKey", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
GET {{baseUrl}}/api/v1/project-categories

> {%%}

### 사용자 1
< {% client.global.set("backer1Email", "ord555-backer1-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{backer1Email}}", "password": "rawPassword1!", "name": "555후원자1", "phoneNumber": "010-1000-0026"}

> {% client.assert(response.status === 200, "signup failed"); %}

###
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{backer1Email}}", "password": "rawPassword1!"}

> {% client.global.set("backer1Token", response.body.data.accessToken); client.global.set("userId1", response.body.data.user.id); %}

###
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backer1Token}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId}}, "quantity": 1}]}

> {% client.assert(response.status === 200, "add to cart failed"); %}

### 사용자 1 — 공용 키로 주문
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backer1Token}}
Content-Type: application/json

{
  "userId": {{userId1}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": 12000}],
  "receiverName": "Kim1", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 12000, "expectedTotalAmount": 15000,
  "orderIdempotencyKey": "{{sharedKey}}"
}

> {%
    client.assert(response.status === 200, "user1 place order failed: " + response.body);
    client.global.set("order1Id", response.body.data.id);
%}

