    client.global.set("backerEmail", "ord540-backer-" + Date.now() + "@earlybird.co.kr");
%}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{backerEmail}}", "password": "rawPassword1!", "name": "540후원자", "phoneNumber": "010-1000-0004"}

> {% client.assert(response.status === 200, "signup failed: " + response.body); %}

### 12. 후원자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{backerEmail}}", "password": "rawPassword1!"}

> {%
    client.global.set("backerAccessToken", response.body.data.accessToken);
    client.global.set("userId", response.body.data.user.id);
%}

### 13. Case A: 상품합계 정확히 50000 — 장바구니 담기
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardIdFree}}, "quantity": 1}]}

> {% client.assert(response.status === 200, "add to cart failed: " + response.body); %}

### 14. Case A 주문 생성 — expectedTotalAmount = 50000 (배송비 0)
< {% request.variables.set("orderIdempotencyKey", crypto.randomUUID()); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardIdFree}}, "quantity": 1, "expectedUnitPrice": 50000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 50000, "expectedTotalAmount": 50000,
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.test("50000원 상품합계 -> 배송비 무료", function() {
        client.assert(response.status === 200, "place order failed: " + response.body);
        client.assert(response.body.data.itemsAmount === 50000, "itemsAmount mismatch: " + response.body.data.itemsAmount);
        client.assert(response.body.data.shippingFee === 0, "shippingFee should be 0: " + response.body.data.shippingFee);
        client.assert(response.body.data.totalAmount === 50000, "totalAmount mismatch: " + response.body.data.totalAmount);
    });
%}

### 15. Case B: 상품합계 49999 — 장바구니 담기
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardIdPaid}}, "quantity": 1}]}

> {% client.assert(response.status === 200, "add to cart failed: " + response.body); %}

### 16. Case B 주문 생성 — expectedTotalAmount = 52999 (배송비 3000)
< {% request.variables.set("orderIdempotencyKey", crypto.randomUUID()); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardIdPaid}}, "quantity": 1, "expectedUnitPrice": 49999}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 49999, "expectedTotalAmount": 52999,
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.test("49999원 상품합계 -> 배송비 3000 부과", function() {
        client.assert(response.status === 200, "place order failed: " + response.body);
        client.assert(response.body.data.itemsAmount === 49999, "itemsAmount mismatch: " + response.body.data.itemsAmount);
        client.assert(response.body.data.shippingFee === 3000, "shippingFee should be 3000: " + response.body.data.shippingFee);
        client.assert(response.body.data.totalAmount === 52999, "totalAmount mismatch: " + response.body.data.totalAmount);
    });
%}
