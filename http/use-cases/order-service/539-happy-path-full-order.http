### 12. 장바구니에 리워드 담기 (수량 2 -> 상품합계 24000)
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "items": [{"rewardId": {{rewardId}}, "quantity": 2}]
}

> {%
    client.test("장바구니 담기 성공", function() {
        client.assert(response.status === 200, "add to cart failed: " + response.body);
    });
%}

### 13. 주문 생성 — 이슈 본문 fixture와 동일한 금액 구조(상품합계 24000, 배송비 3000, 총액 27000)
< {%
    request.variables.set("orderIdempotencyKey", crypto.randomUUID());
%}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}},
  "projectId": {{projectId}},
  "requests": [
    {"rewardId": {{rewardId}}, "quantity": 2, "expectedUnitPrice": 12000}
  ],
  "receiverName": "Kim",
  "receiverPhone": "010-1111-2222",
  "shippingAddress": "Seoul",
  "zipCode": "01234",
  "expectedItemsAmount": 24000,
  "expectedTotalAmount": 27000,
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.test("주문 생성 성공, PAID", function() {
        client.assert(response.status === 200, "place order failed: " + response.body);
        client.assert(response.body.data.result.code === "ORDER_CREATED", "unexpected result code: " + JSON.stringify(response.body.data.result));
        client.assert(response.body.data.status === "PAID", "unexpected order status: " + response.body.data.status);
        client.assert(response.body.data.itemsAmount === 24000, "unexpected itemsAmount: " + response.body.data.itemsAmount);
        client.assert(response.body.data.shippingFee === 3000, "unexpected shippingFee: " + response.body.data.shippingFee);
        client.assert(response.body.data.totalAmount === 27000, "unexpected totalAmount: " + response.body.data.totalAmount);
        client.assert(!!response.body.data.id, "order id missing");
    });
    client.global.set("orderId", response.body.data.id);
%}

### 14. 주문 상세 재조회 — order_items에 스냅샷된 리워드 이름/단가/수량 확인
GET {{baseUrl}}/api/v1/orders/{{orderId}}?userId={{userId}}
Authorization: Bearer {{backerAccessToken}}

> {%
    client.test("주문 상세에 orderItems 스냅샷 반영", function() {
        client.assert(response.status === 200, "get order detail failed: " + response.body);
        const item = response.body.data.orderItems[0];
        client.assert(item.name === "Reward A", "unexpected item name: " + item.name);
        client.assert(item.price === 12000, "unexpected item price: " + item.price);
        client.assert(item.quantity === 2, "unexpected item quantity: " + item.quantity);
    });
%}

### 15. 장바구니가 비워졌는지 확인 (cart cleanup)
GET {{baseUrl}}/api/v1/carts
Authorization: Bearer {{backerAccessToken}}

> {%
    client.test("주문한 리워드가 장바구니에서 제거됨", function() {
        client.assert(response.status === 200, "get cart failed: " + response.body);
        client.assert(response.body.data.itemCount === 0, "cart still has items: " + JSON.stringify(response.body.data));
    });
%}

### 참고: order_items.stock_reserved, cart_cleanup_outboxes(COMPLETED), order_payment_status_outboxes(PUBLISHED),
### Reward 재고 -2, Project 후원 금액 반영 등 DB 레벨 상세 값은 위 API 응답만으로는 검증 불가 — 필요 시 DB 직접 확인.
