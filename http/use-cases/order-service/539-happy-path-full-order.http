POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{creatorAccessToken}}
Content-Type: application/json

{
  "bankCode": "88",
  "accountNumber": "110-539-000001",
  "accountHolder": "539테스트창작자"
}

> {%
    client.test("창작자 전환 성공", function() {
        client.assert(response.status === 200, "register as creator failed: " + response.body);
    });
%}

### 4. access token 재발급 (CREATOR role 반영)
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{
  "refreshToken": "{{creatorRefreshToken}}"
}

> {%
    client.global.set("creatorAccessToken", response.body.data.accessToken);
%}

### 5. 카테고리 조회
GET {{baseUrl}}/api/v1/project-categories
Authorization: Bearer {{creatorAccessToken}}

> {%
    client.global.set("categoryId", response.body.data[0].id);
%}

### 6. 프로젝트 등록 (PENDING_REVIEW)
< {%
    const now = new Date();
    const endAt = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    request.variables.set("startAt", now.toISOString().slice(0, 19));
    request.variables.set("endAt", endAt.toISOString().slice(0, 10));
%}
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{creatorAccessToken}}
Content-Type: application/json

{
  "title": "539 정상 주문 테스트 프로젝트",
  "categoryId": {{categoryId}},
  "summary": "CASE-01 정상 생성/결제 검증용",
  "description": "539-happy-path-full-order.http",
  "goalAmount": 1000000,
  "startAt": "{{startAt}}",
  "endAt": "{{endAt}}"
}

> {%
    client.global.set("projectId", response.body.data.projectId);
%}

### 7. 리워드 등록 (단가 12000, 재고 10)
POST {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{creatorAccessToken}}
Content-Type: application/json

{
  "name": "Reward A",
  "description": "539 테스트 리워드",
  "price": 12000,
  "totalQuantity": 10
}

> {%
    client.test("리워드 등록 성공", function() {
        client.assert(response.status === 200, "register reward failed: " + response.body);
    });
    client.global.set("rewardId", response.body.data.rewardId);
%}

