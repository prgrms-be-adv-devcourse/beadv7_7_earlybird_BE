### 12. Cart에는 수량 2만 담는다 (재고는 10 남아있음)
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId}}, "quantity": 2}]}

> {% client.assert(response.status === 200, "add to cart failed"); %}

### 13. 요청 body에는 quantity=99를 넣지만 실제 주문 수량은 Cart 기준 2여야 한다
### expectedItemsAmount/TotalAmount도 Cart 수량(2) 기준인 24000/27000으로 보낸다 — 99 기준(1188000)으로
### 보내면 CASE-10(금액 불일치 400)에 걸려버려 이 케이스(수량 우선)를 검증할 수 없다.
< {% request.variables.set("orderIdempotencyKey", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 99, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 24000, "expectedTotalAmount": 27000,
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.test("요청 quantity=99는 무시되고 Cart 수량(2)이 사용됨", function() {
        client.assert(response.status === 200, "place order failed: " + response.body);
        client.assert(response.body.data.status === "PAID", "unexpected status: " + response.body.data.status);
        client.assert(response.body.data.orderItems[0].quantity === 2, "quantity should be overridden to 2, got " + response.body.data.orderItems[0].quantity);
        client.assert(response.body.data.itemsAmount === 24000, "itemsAmount mismatch: " + response.body.data.itemsAmount);
    });
%}
