### 새 UUID로 첫 요청 -> 정확히 하나의 Order 생성
< {% client.global.set("newKey", crypto.randomUUID()); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 12000, "expectedTotalAmount": 15000,
  "orderIdempotencyKey": "{{newKey}}"
}

> {%
    client.test("첫 요청 성공, Order 하나 생성", function() {
        client.assert(response.status === 200, "place order failed: " + response.body);
        client.assert(!!response.body.data.id, "order id missing");
    });
    client.global.set("orderId", response.body.data.id);
%}

### 내 후원 내역 조회 — 같은 orderId를 가진 주문이 하나만 존재하는지 확인
GET {{baseUrl}}/api/v1/orders/me?userId={{userId}}
Authorization: Bearer {{backerAccessToken}}

> {%
    client.test("동일 orderId 정확히 1건", function() {
        const matches = response.body.data.filter(o => String(o.id) === String(client.global.get("orderId")));
        client.assert(matches.length === 1, "expected exactly 1 order, got " + matches.length);
    });
%}
