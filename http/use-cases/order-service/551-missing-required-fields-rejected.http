### 1. requests 빈 배열
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "requests": [],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 10000, "expectedTotalAmount": 13000,
  "orderIdempotencyKey": "11111111-0000-0000-0000-000000000001"
}

> {% client.test("빈 requests -> 400", function() { client.assert(response.status === 400, "expected 400, got " + response.status); }); %}

### 2. receiverName 빈 문자열
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "requests": [{"rewardId": 1, "quantity": 1, "expectedUnitPrice": 10000}],
  "receiverName": "", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 10000, "expectedTotalAmount": 13000,
  "orderIdempotencyKey": "11111111-0000-0000-0000-000000000002"
}

> {% client.test("빈 receiverName -> 400", function() { client.assert(response.status === 400, "expected 400, got " + response.status); }); %}

