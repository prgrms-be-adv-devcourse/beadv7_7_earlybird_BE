### Cart에 두 품목 담기: 101 x2, 102 x3
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{reward101}}, "quantity": 2}, {"rewardId": {{reward102}}, "quantity": 3}]}

> {% client.assert(response.status === 200, "add to cart failed"); %}

### 주문 — 상품합계 = 12000*2 + 8000*3 = 48000, 배송비 3000, 총액 51000
< {% request.variables.set("orderIdempotencyKey", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [
    {"rewardId": {{reward101}}, "quantity": 2, "expectedUnitPrice": 12000},
    {"rewardId": {{reward102}}, "quantity": 3, "expectedUnitPrice": 8000}
  ],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 48000, "expectedTotalAmount": 51000,
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.test("다중 품목 재고 확보 + 결제 성공", function() {
        client.assert(response.status === 200, "place order failed: " + response.body);
        client.assert(response.body.data.status === "PAID", "unexpected status: " + response.body.data.status);
        client.assert(response.body.data.orderItems.length === 2, "expected 2 order items, got " + response.body.data.orderItems.length);
        client.assert(response.body.data.itemsAmount === 48000, "itemsAmount mismatch: " + response.body.data.itemsAmount);
    });
%}
