### 정상 주문 -> 이미 PAID로 끝난다
< {% request.variables.set("orderIdempotencyKey", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16); })); %}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{backerAccessToken}}
Content-Type: application/json

{
  "userId": {{userId}}, "projectId": {{projectId}},
  "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": 12000}],
  "receiverName": "Kim", "receiverPhone": "010-1111-2222", "shippingAddress": "Seoul", "zipCode": "01234",
  "expectedItemsAmount": 12000, "expectedTotalAmount": 15000,
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.assert(response.status === 200, "place order failed: " + response.body);
    client.assert(response.body.data.status === "PAID", "expected PAID immediately, got " + response.body.data.status);
    client.global.set("orderId", response.body.data.id);
%}

### 이미 PAID인 주문에 같은 PAID callback을 중복으로 한 번 더 전달 — order-service 직접 호출(local 전용)
PUT {{orderServiceUrl}}/internal/v1/orders/{{orderId}}/payment-status
Content-Type: application/json

{"status": "PAID"}

> {%
    client.test("중복 PAID callback도 200으로 받아들여짐", function() {
        client.assert(response.status === 200, "duplicate PAID callback failed: " + response.body);
    });
%}

### 주문이 여전히 PAID이고 이상 없이 유지되는지 확인 (게이트웨이 경유)
GET {{baseUrl}}/api/v1/orders/{{orderId}}?userId={{userId}}
Authorization: Bearer {{backerAccessToken}}

> {%
    client.test("중복 callback 이후에도 주문은 PAID로 그대로", function() {
        client.assert(response.status === 200, "get order detail failed: " + response.body);
        client.assert(response.body.data.status === "PAID", "unexpected status after duplicate callback: " + response.body.data.status);
    });
%}

### 참고: Reward 재고가 다시 차감되지 않았는지, Payment/Outbox가 중복 생성되지 않았는지는 DB 직접 확인 필요.
