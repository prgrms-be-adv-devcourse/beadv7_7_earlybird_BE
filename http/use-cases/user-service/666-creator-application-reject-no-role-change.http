### 666-creator-application-reject-no-role-change.http — 창작자 전환 신청 반려 — role 미변경 + 사유 기록
### https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/666
###
### ADMIN이 /creator-applications/{id}/reject 로 신청을 반려하면 상태가 REJECTED로 바뀌고
### rejectReason이 기록되지만, 신청자의 role은 BACKER로 그대로 유지되는지 확인한다.

### 1. 회원가입 (신청자)
< {%
    client.global.set("userEmail", "uc666-" + Date.now() + "@earlybird.co.kr");
%}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!",
  "name": "유스케이스666",
  "phoneNumber": "010-1111-2222"
}

> {%
    client.test("회원가입 성공(200)", function() {
        client.assert(response.status === 200, "signup failed: " + response.body);
    });
%}

### 2. 로그인 (신청자)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!"
}

> {%
    client.test("로그인 성공", function() {
        client.assert(response.status === 200, "login failed: " + response.body);
    });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 3. 창작자 전환 신청
POST {{baseUrl}}/api/v1/users/me/creator-application
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "creatorName": "유스케이스666 창작자",
  "category": "테크",
  "introduction": "반려 시나리오 테스트",
  "businessNumber": "123-45-67890",
  "portfolioUrl": "https://example.com/portfolio",
  "bankCode": "88",
  "accountNumber": "110-123-456789",
  "accountHolder": "유스케이스666"
}

> {%
    client.test("신청 생성 성공, 상태 PENDING", function() {
        client.assert(response.status === 200, "apply failed: " + response.body);
        client.assert(response.body.data.status === "PENDING", "unexpected status: " + response.body.data.status);
    });
    client.global.set("applicationId", response.body.data.id);
%}

### 4. 관리자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "admin@earlybird.co.kr",
  "password": "rawPassword3!"
}

> {%
    client.test("관리자 로그인 성공(role=ADMIN)", function() {
        client.assert(response.status === 200, "admin login failed: " + response.body);
        client.assert(response.body.data.user.role === "ADMIN", "unexpected role: " + response.body.data.user.role);
    });
    client.global.set("adminAccessToken", response.body.data.accessToken);
%}

### 5. 관리자: 신청 반려
POST {{baseUrl}}/api/v1/users/creator-applications/{{applicationId}}/reject
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "reason": "포트폴리오 정보 부족 (유스케이스666 테스트 사유)"
}

> {%
    client.test("반려 성공, 상태 REJECTED, 사유 기록됨", function() {
        client.assert(response.status === 200, "reject failed: " + response.body);
        client.assert(response.body.data.status === "REJECTED", "unexpected status: " + response.body.data.status);
        client.assert(response.body.data.rejectReason === "포트폴리오 정보 부족 (유스케이스666 테스트 사유)", "rejectReason not recorded correctly");
    });
%}

### 6. 신청자: 내 정보 재조회 — role이 여전히 BACKER인지 확인
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{accessToken}}

> {%
    client.test("반려 후에도 role은 BACKER로 유지", function() {
        client.assert(response.status === 200, "get me failed: " + response.body);
        client.assert(response.body.data.role === "BACKER", "unexpected role: " + response.body.data.role);
    });
%}
