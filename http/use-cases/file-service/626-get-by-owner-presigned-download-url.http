### 7. presign 발급
POST {{baseUrl}}/api/v1/files/presigned-upload
Authorization: Bearer {{file626AccessToken}}
Content-Type: application/json

{
  "contentType": "image/png",
  "originalName": "thumbnail.png"
}

> {%
    client.test("presign 발급 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("file626StoredUrl", response.body.data.storedUrl);
%}

### 8. 파일 등록
POST {{baseUrl}}/api/v1/files
Authorization: Bearer {{file626AccessToken}}
Content-Type: application/json

{
  "ownerType": "PROJECT",
  "ownerId": {{file626ProjectId}},
  "storedUrl": "{{file626StoredUrl}}",
  "originalName": "thumbnail.png",
  "contentType": "image/png",
  "fileSize": 102400,
  "sortOrder": 0
}

> {%
    client.test("파일 등록 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("file626FileId", response.body.data.id);
%}

### 9. 비로그인으로 owner 기준 조회 — GET /api/v1/files는 permitAll
GET {{baseUrl}}/api/v1/files?ownerType=PROJECT&ownerId={{file626ProjectId}}

> {%
    client.test("비로그인 조회 성공(200), 방금 등록한 파일 포함 + presigned URL로 치환됨", function() {
        client.assert(response.status === 200, "get by owner failed: " + response.body);
        const files = response.body.data;
        const found = files.find(f => String(f.id) === String(client.global.get("file626FileId")));
        client.assert(!!found, "registered file not found in owner list");
        client.assert(found.storedUrl !== client.global.get("file626StoredUrl"), "storedUrl should be replaced with a presigned GET URL, not the raw registered value");
        client.assert(found.storedUrl.indexOf("?") !== -1, "storedUrl doesn't look like a presigned URL (no query string): " + found.storedUrl);
    });
%}
