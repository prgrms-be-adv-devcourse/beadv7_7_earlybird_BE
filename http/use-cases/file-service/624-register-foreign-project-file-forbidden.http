### 9. CREATOR2로 별도 presign 발급 후 확보 (실제 업로드는 CASE-01과 동일하게 생략 가능)
POST {{baseUrl}}/api/v1/files/presigned-upload
Authorization: Bearer {{file624AccessToken2}}
Content-Type: application/json

{
  "contentType": "image/png",
  "originalName": "other.png"
}

> {%
    client.test("CREATOR2 presign 발급 성공", function() { client.assert(response.status === 200, response.body); });
    client.global.set("file624StoredUrl2", response.body.data.storedUrl);
%}

### 10. CREATOR2가 CREATOR1 소유 프로젝트를 ownerId로 지정해 등록 시도 — 403 기대
POST {{baseUrl}}/api/v1/files
Authorization: Bearer {{file624AccessToken2}}
Content-Type: application/json

{
  "ownerType": "PROJECT",
  "ownerId": {{file624ProjectId}},
  "storedUrl": "{{file624StoredUrl2}}",
  "originalName": "other.png",
  "contentType": "image/png",
  "fileSize": 51200,
  "sortOrder": 0
}

> {%
    client.test("403 Forbidden (본인 소유 프로젝트 아님)", function() {
        client.assert(response.status === 403, "expected 403, got " + response.status + ": " + response.body);
    });
%}
