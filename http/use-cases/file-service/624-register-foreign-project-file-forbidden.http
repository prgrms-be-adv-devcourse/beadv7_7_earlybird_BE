### 8. CREATOR2 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{file624Email2}}",
  "password": "rawPassword1!"
}

> {%
    client.test("CREATOR2 로그인 성공", function() { client.assert(response.status === 200, response.body); });
