### 11. CREATOR2(비업로더)가 삭제 시도 — 403 기대
DELETE {{baseUrl}}/api/v1/files/{{file627FileId}}
Authorization: Bearer {{file627AccessToken2}}

> {%
    client.test("403 Forbidden (업로더 본인 아님)", function() {
        client.assert(response.status === 403, "expected 403, got " + response.status + ": " + response.body);
    });
%}
