### 14. PROJECT 조회 — 방금 등록한 댓글 포함
GET {{baseUrl}}/api/v1/comments?targetType=PROJECT&targetId={{projectId}}
Authorization: Bearer {{accessToken}}

> {% client.test("PROJECT 댓글 목록에 포함", function() { const found = response.body.data.some(c => String(c.id) === String(client.global.get("projectCommentId"))); client.assert(found, "not found in PROJECT comments"); }); %}

### 15. PROJECT_NOTICE 조회 — 방금 등록한 댓글 포함
GET {{baseUrl}}/api/v1/comments?targetType=PROJECT_NOTICE&targetId={{noticeId}}
Authorization: Bearer {{accessToken}}

> {% client.test("PROJECT_NOTICE 댓글 목록에 포함", function() { const found = response.body.data.some(c => String(c.id) === String(client.global.get("noticeCommentId"))); client.assert(found, "not found in PROJECT_NOTICE comments"); }); %}

### 16. REVIEW 조회 — 방금 등록한 댓글 포함
GET {{baseUrl}}/api/v1/comments?targetType=REVIEW&targetId={{reviewId}}
Authorization: Bearer {{accessToken}}

> {% client.test("REVIEW 댓글 목록에 포함", function() { const found = response.body.data.some(c => String(c.id) === String(client.global.get("reviewCommentId"))); client.assert(found, "not found in REVIEW comments"); }); %}
