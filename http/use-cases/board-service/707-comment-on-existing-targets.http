Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"content": "공지에 대한 문의입니다"}

> {% client.test("PROJECT_NOTICE 댓글 등록 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("noticeCommentId", response.body.data.id); %}

### 13. REVIEW 대상 댓글 등록
POST {{baseUrl}}/api/v1/comments?targetType=REVIEW&targetId={{reviewId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"content": "리뷰에 대한 문의입니다"}

