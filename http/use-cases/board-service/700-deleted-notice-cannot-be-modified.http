### 700-deleted-notice-cannot-be-modified.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/700
### 이미 삭제된 공지는 재수정/재삭제할 수 없다 (ProjectNotice.validateNotDeleted → 409)
###
### 작성자를 CREATOR로 전환해 두는 이유: 삭제 후 재수정을 PATCH로 시도하는데, 게이트웨이가
### PATCH /api/v1/notices/*를 hasRole(CREATOR)로 막아 놓았기 때문(작성자 본인이라도 CREATOR가 아니면
### board-service에 닿기도 전에 403이 난다).

### 1. 작성자(창작자) 회원가입
< {% client.global.set("authorEmail", "board700-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{authorEmail}}", "password": "rawPassword1!", "name": "공지700작성자", "phoneNumber": "010-7000-0001"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{authorEmail}}", "password": "rawPassword1!"}

> {% client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("refreshToken", response.body.data.refreshToken); client.global.set("accessToken", response.body.data.accessToken); %}

### 3. 창작자 전환
POST {{baseUrl}}/api/v1/users/me/creator
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"bankCode": "88", "accountNumber": "110-700-000001", "accountHolder": "공지700작성자"}

> {% client.test("창작자 전환 성공", function() { client.assert(response.status === 200 && response.body.data.role === "CREATOR", response.body); }); %}

### 4. 토큰 재발급
POST {{baseUrl}}/api/v1/users/refresh
Content-Type: application/json

{"refreshToken": "{{refreshToken}}"}

> {% client.test("재발급 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("accessToken", response.body.data.accessToken); %}

### 5. 대상 프로젝트 확보
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {% client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); }); client.global.set("projectId", response.body.data[0].projectId); %}

### 6. 공지 등록
POST {{baseUrl}}/api/v1/notices?projectId={{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title": "곧 삭제될 공지", "content": "곧 삭제될 내용"}

> {% client.test("공지 등록 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("noticeId", response.body.data.id); %}

### 7. 작성자 본인이 삭제 (CREATOR 역할이므로 게이트웨이 통과)
DELETE {{baseUrl}}/api/v1/notices/{{noticeId}}
Authorization: Bearer {{accessToken}}

> {% client.test("삭제 성공(200)", function() { client.assert(response.status === 200, response.body); }); %}

### 8. 재수정 시도 — 409
PATCH {{baseUrl}}/api/v1/notices/{{noticeId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title": "재수정 시도", "content": "재수정 내용"}

> {%
    client.test("재수정은 409로 거부", function() {
        client.assert(response.status === 409, "expected 409, got " + response.status + ": " + response.body);
        client.assert(response.body.error.message === "이미 삭제된 공지글입니다.", "unexpected message: " + response.body.error.message);
    });
%}

### 9. 재삭제 시도 — 409
DELETE {{baseUrl}}/api/v1/notices/{{noticeId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("재삭제는 409로 거부", function() {
        client.assert(response.status === 409, "expected 409, got " + response.status + ": " + response.body);
        client.assert(response.body.error.message === "이미 삭제된 공지글입니다.", "unexpected message: " + response.body.error.message);
    });
%}
