{"content": "부모 댓글"}

> {% client.test("부모 댓글 등록 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("commentId", response.body.data.id); %}

### 9. C1의 답글
POST {{baseUrl}}/api/v1/comments/{{commentId}}/replies
Authorization: Bearer {{c1Token}}
Content-Type: application/json

{"content": "답글 1"}

> {% client.test("답글 1 등록 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("reply1Id", response.body.data.id); %}

### 10. C2의 답글
POST {{baseUrl}}/api/v1/comments/{{commentId}}/replies
Authorization: Bearer {{c2Token}}
Content-Type: application/json

{"content": "답글 2"}

> {% client.test("답글 2 등록 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("reply2Id", response.body.data.id); %}

### 11. 목록 조회 — 부모 하나, replies 안에 답글 1·2 모두 포함(누락/별도 루트 분리 없이)
GET {{baseUrl}}/api/v1/comments?targetType=PROJECT&targetId={{projectId}}
Authorization: Bearer {{authorToken}}

> {%
    client.test("두 답글 모두 부모 밑에 그룹핑됨", function() {
        client.assert(response.status === 200, response.body);
        const parent = response.body.data.find(c => String(c.id) === String(client.global.get("commentId")));
        client.assert(parent != null, "parent comment not found as root");
        const replyIds = parent.replies.map(r => String(r.id));
        client.assert(replyIds.includes(String(client.global.get("reply1Id"))), "reply1 missing");
        client.assert(replyIds.includes(String(client.global.get("reply2Id"))), "reply2 missing");
        client.assert(parent.replies.length === 2, "expected exactly 2 replies, got " + parent.replies.length);
        const strayRoots = response.body.data.filter(c => c.id === client.global.get("reply1Id") || c.id === client.global.get("reply2Id"));
        client.assert(strayRoots.length === 0, "replies should not appear as separate roots");
    });
%}
