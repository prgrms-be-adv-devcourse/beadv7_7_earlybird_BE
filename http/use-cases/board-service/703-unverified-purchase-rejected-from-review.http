### 703-unverified-purchase-rejected-from-review.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/703
### 해당 rewardId를 구매/확정한 이력이 없는 사용자가 리뷰를 등록하려 하면
### PurchaseNotVerifiedException(403)으로 거부된다

### 1. 회원가입 (장바구니/주문 없이 바로 리뷰 시도)
< {% client.global.set("userEmail", "board703-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!", "name": "리뷰703미구매자", "phoneNumber": "010-7030-0001"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!"}

> {% client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("accessToken", response.body.data.accessToken); %}

### 3. 진행중인 프로젝트/리워드 조회 (구매는 하지 않음)
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {% client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); }); client.global.set("projectId", response.body.data[0].projectId); %}

### 4. 리워드 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}

> {% client.test("리워드 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); }); client.global.set("rewardId", response.body.data[0].rewardId); %}

### 5. 구매 없이 리뷰 등록 시도 — 403
POST {{baseUrl}}/api/v1/reviews?projectId={{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"rewardId": {{rewardId}}, "rating": 5, "content": "구매 안했는데 남겨봄"}

> {%
    client.test("미구매 리뷰 등록은 403으로 거부", function() {
        client.assert(response.status === 403, "expected 403, got " + response.status + ": " + response.body);
        client.assert(response.body.error.message.indexOf("구매가 확인되지 않아") === 0, "unexpected message: " + response.body.error.message);
    });
%}

### 6. 목록 조회 — 저장되지 않았어야 함
GET {{baseUrl}}/api/v1/reviews?projectId={{projectId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("목록에 저장되지 않음", function() {
        client.assert(response.status === 200, response.body);
        const found = response.body.data.some(r => r.rewardId === client.global.get("rewardId") && r.content === "구매 안했는데 남겨봄");
        client.assert(!found, "unverified review should not have been saved");
    });
%}
