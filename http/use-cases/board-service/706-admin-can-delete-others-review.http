### 706-admin-can-delete-others-review.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/706
### 삭제는 수정과 달리 ADMIN 예외가 있어, 작성자 본인이 아니어도 ADMIN이면 삭제가 허용된다 (Review.validateOwnership)
###
### 1~8번은 backer-flow.http와 동일한 구매 확정 시나리오.

### production은 실제 Toss PG를 쓰고 로컬은 fake 게이트웨이를 쓴다(backer-flow.http #149와 동일 caveat) —
### 그래서 결제 승인(8번, 또는 이에 대응하는 단계) 이후로는 임의 paymentKey로 production에서 끝까지
### 통과하지 못한다. 이 파일의 구매 확정 이후 단계(리뷰 등록 등)는 local 환경에서만 끝까지 검증 가능하다.
###

### 1. 회원가입
< {% client.global.set("userEmail", "board706-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!", "name": "리뷰706구매자", "phoneNumber": "010-7060-0001"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!"}

> {% client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("accessToken", response.body.data.accessToken); client.global.set("userId", response.body.data.user.id); %}

### 3. 진행중인 프로젝트 조회
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {% client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); }); client.global.set("projectId", response.body.data[0].projectId); %}

### 4. 리워드 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}

> {% client.test("리워드 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); }); client.global.set("rewardId", response.body.data[0].rewardId); client.global.set("rewardPrice", response.body.data[0].price); %}

### 5. 장바구니 담기
POST {{baseUrl}}/api/v1/carts/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"projectId": {{projectId}}, "items": [{"rewardId": {{rewardId}}, "quantity": 1}]}

> {% client.test("장바구니 담기 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 6. 후원(주문 생성)
< {%
    const price = Number(client.global.get("rewardPrice"));
    const shippingFee = price >= 50000 ? 0 : 3000;
    request.variables.set("expectedItemsAmount", price);
    request.variables.set("expectedTotalAmount", price + shippingFee);
    client.global.set("expectedTotalAmount", price + shippingFee);
%}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"userId": {{userId}}, "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": {{rewardPrice}}}], "receiverName": "리뷰706구매자", "receiverPhone": "010-7060-0001", "shippingAddress": "서울시 강남구", "zipCode": "06236", "expectedItemsAmount": {{expectedItemsAmount}}, "expectedTotalAmount": {{expectedTotalAmount}}, "orderIdempotencyKey": "{{$uuid}}"}

> {% client.test("후원 생성 성공(PAYMENT_PENDING)", function() { client.assert(response.status === 200 && response.body.data.status === "PAYMENT_PENDING", response.body); }); client.global.set("orderId", response.body.data.id); %}

### 7. 결제 정보 조회
GET {{baseUrl}}/api/v1/payments?orderId={{orderId}}
Authorization: Bearer {{accessToken}}

> {% client.test("결제 정보 조회 성공(READY)", function() { client.assert(response.status === 200 && response.body.data.status === "READY", response.body); }); client.global.set("pgOrderId", response.body.data.pgOrderId); %}

### 8. 결제 승인
POST {{baseUrl}}/api/v1/payments/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"paymentKey": "{{$uuid}}", "pgOrderId": "{{pgOrderId}}", "amount": {{expectedTotalAmount}}}

> {% client.test("결제 승인 성공(PAID)", function() { client.assert(response.status === 200 && response.body.data.status === "PAID", response.body); }); %}

### 9. 리뷰 등록
POST {{baseUrl}}/api/v1/reviews?projectId={{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"rewardId": {{rewardId}}, "rating": 2, "content": "삭제될 리뷰"}

> {% client.test("리뷰 등록 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("reviewId", response.body.data.id); %}

### 10. 관리자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "admin@earlybird.co.kr", "password": "rawPassword3!"}

> {% client.test("관리자 로그인 성공", function() { client.assert(response.status === 200 && response.body.data.user.role === "ADMIN", response.body); }); client.global.set("adminAccessToken", response.body.data.accessToken); %}

### 11. 관리자가 삭제 — 성공
DELETE {{baseUrl}}/api/v1/reviews/{{reviewId}}
Authorization: Bearer {{adminAccessToken}}

> {% client.test("관리자 삭제 성공(200)", function() { client.assert(response.status === 200, "expected 200, got " + response.status + ": " + response.body); }); %}

### 12. 목록 조회 — 삭제된 리뷰는 노출되지 않음
GET {{baseUrl}}/api/v1/reviews?projectId={{projectId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("목록에서 삭제된 리뷰 제외", function() {
        client.assert(response.status === 200, response.body);
        const found = response.body.data.some(r => String(r.id) === String(client.global.get("reviewId")));
        client.assert(!found, "deleted review should not appear in list");
    });
%}
