### 14. A 후원(주문 생성)
< {%
    const price = Number(client.global.get("rewardPrice"));
    const shippingFee = price >= 50000 ? 0 : 3000;
    request.variables.set("expectedItemsAmount", price);
    request.variables.set("expectedTotalAmount", price + shippingFee);
    client.global.set("expectedTotalAmount", price + shippingFee);
%}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{accessTokenA}}
Content-Type: application/json

{"userId": {{userIdA}}, "requests": [{"rewardId": {{rewardId}}, "quantity": 1, "expectedUnitPrice": {{rewardPrice}}}], "receiverName": "716작성자A", "receiverPhone": "010-7160-0001", "shippingAddress": "서울시 강남구", "zipCode": "06236", "expectedItemsAmount": {{expectedItemsAmount}}, "expectedTotalAmount": {{expectedTotalAmount}}, "orderIdempotencyKey": "{{$uuid}}"}

> {% client.test("후원 생성 성공(PAYMENT_PENDING)", function() { client.assert(response.status === 200 && response.body.data.status === "PAYMENT_PENDING", response.body); }); client.global.set("orderId", response.body.data.id); %}

