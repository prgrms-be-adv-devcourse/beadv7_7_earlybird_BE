### 712-admin-can-delete-others-comment.http — https://github.com/prgrms-be-adv-devcourse/beadv7_7_earlybird_BE/issues/712
### 댓글 삭제는 수정과 달리 ADMIN 예외가 있어, 작성자 본인이 아니어도 ADMIN이면 소프트 삭제가 허용된다
### (Comment.validateOwnership)

### 1. 작성자 회원가입
< {% client.global.set("userEmail", "board712-" + Date.now() + "@earlybird.co.kr"); %}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!", "name": "댓글712작성자", "phoneNumber": "010-7120-0001"}

> {% client.test("회원가입 성공", function() { client.assert(response.status === 200, response.body); }); %}

### 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "{{userEmail}}", "password": "rawPassword1!"}

> {% client.test("로그인 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("accessToken", response.body.data.accessToken); %}

### 3. 대상 프로젝트 확보
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {% client.test("프로젝트 조회 성공", function() { client.assert(response.status === 200 && response.body.data.length > 0, response.body); }); client.global.set("projectId", response.body.data[0].projectId); %}

### 4. 댓글 등록
POST {{baseUrl}}/api/v1/comments?targetType=PROJECT&targetId={{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"content": "삭제될 댓글"}

> {% client.test("댓글 등록 성공", function() { client.assert(response.status === 200, response.body); }); client.global.set("commentId", response.body.data.id); %}

### 5. 관리자 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{"email": "admin@earlybird.co.kr", "password": "rawPassword3!"}

> {% client.test("관리자 로그인 성공", function() { client.assert(response.status === 200 && response.body.data.user.role === "ADMIN", response.body); }); client.global.set("adminAccessToken", response.body.data.accessToken); %}

### 6. 관리자가 삭제 — 성공
DELETE {{baseUrl}}/api/v1/comments/{{commentId}}
Authorization: Bearer {{adminAccessToken}}

> {% client.test("관리자 삭제 성공(200)", function() { client.assert(response.status === 200, "expected 200, got " + response.status + ": " + response.body); }); %}

### 7. 목록 조회 — 소프트 삭제되어 더 이상 노출되지 않음
GET {{baseUrl}}/api/v1/comments?targetType=PROJECT&targetId={{projectId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("목록에서 삭제된 댓글 제외", function() {
        client.assert(response.status === 200, response.body);
        const found = response.body.data.some(c => String(c.id) === String(client.global.get("commentId")));
        client.assert(!found, "deleted comment should not appear in list");
    });
%}
