### backer-flow.http — 실제 후원자 플로우 시뮬레이션 (이슈 #149)
###
### 회원가입 → 로그인 → 프로젝트/리워드 조회 → 장바구니 담기 → 후원(주문 생성, PG 결제 승인 포함) →
### 내 후원 내역 조회 → 후원 취소 로 이어지는 시나리오를 순서대로 실행한다.
###
### 환경 전환: IntelliJ 우측 상단(또는 이 파일 우측 상단) 환경 드롭다운에서 `local` / `production` 선택
### — 두 환경의 baseUrl 은 같은 폴더의 http-client.env.json 에 정의돼 있다. 매 요청은 위에서부터
### 순서대로 실행해야 한다(응답 값을 다음 요청이 전역 변수로 이어받는다).
###
### 주의: system-test/.../BackerFlowLiveTest.java 가 같은 시나리오를 JUnit으로 중복 구현한다
### (의도적 — 이 파일은 수동 확인/시연용, 그쪽은 자동화용). 이 파일을 고치면 그 테스트도 같이 고칠 것.
###

### 1. 회원가입
< {%
    // client.global 은 요청 간에 유지된다 — 2번(로그인)에서도 같은 이메일을 써야 하므로
    // 요청 1회성인 request.variables 대신 client.global 을 쓴다.
    client.global.set("userEmail", "backerflow-" + Date.now() + "@earlybird.co.kr");
%}
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!",
  "name": "플로우테스트",
  "phoneNumber": "010-1234-5678"
}

> {%
    client.test("회원가입 성공(200)", function() {
        client.assert(response.status === 200, "signup failed: " + response.body);
    });
%}

### 2. 로그인 (access/refresh token 발급)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "rawPassword1!"
}

> {%
    client.test("로그인 성공, 토큰 발급", function() {
        client.assert(response.status === 200, "login failed: " + response.body);
        client.assert(!!response.body.data.accessToken, "accessToken missing");
    });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
    client.global.set("userId", response.body.data.user.id);
%}

### 3. 진행중인 프로젝트 목록 조회
GET {{baseUrl}}/api/v1/projects?status=IN_PROGRESS
Authorization: Bearer {{accessToken}}

> {%
    client.test("프로젝트 목록 조회 성공, 1건 이상", function() {
        client.assert(response.status === 200, "project list failed: " + response.body);
        client.assert(response.body.data.length > 0, "no IN_PROGRESS projects to back");
    });
    client.global.set("projectId", response.body.data[0].projectId);
%}

### 4. 해당 프로젝트의 리워드 목록 조회
GET {{baseUrl}}/api/v1/projects/{{projectId}}/rewards
Authorization: Bearer {{accessToken}}

> {%
    client.test("리워드 목록 조회 성공, 1건 이상", function() {
        client.assert(response.status === 200, "reward list failed: " + response.body);
        client.assert(response.body.data.length > 0, "no rewards to back");
    });
    client.global.set("rewardId", response.body.data[0].rewardId);
    client.global.set("rewardPrice", response.body.data[0].price);
%}

### 5. 장바구니에 리워드 담기 — 주문 생성이 요구하는 항목은 장바구니 내용과 정확히 일치해야 한다
### (OrderApiService#commandFromCart)
POST {{baseUrl}}/api/v1/users/{{userId}}/cart/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "items": [{"rewardId": {{rewardId}}, "quantity": 1}]
}

> {%
    client.test("장바구니 담기 성공", function() {
        client.assert(response.status === 200, "add to cart failed: " + response.body);
        client.assert(response.body.data.itemCount > 0, "cart is still empty after add");
    });
%}

### 6. 후원(주문 생성) — 장바구니 내용대로 재고 차감 + PG 결제 승인(스텁) 포함
< {%
    const price = Number(client.global.get("rewardPrice"));
    const shippingFee = price >= 50000 ? 0 : 3000;
    request.variables.set("expectedItemsAmount", price);
    request.variables.set("expectedTotalAmount", price + shippingFee);
    // 같은 (userId, orderIdempotencyKey) 재요청은 새 주문 대신 기존 주문을 그대로 반환한다
    // (OrderApiService#placeOrder) - 매 실행마다 새 주문이 나오도록 매번 새로 발급.
    request.variables.set("orderIdempotencyKey", crypto.randomUUID());
%}
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userId": {{userId}},
  "requests": [
    {
      "rewardId": {{rewardId}},
      "quantity": 1,
      "expectedUnitPrice": {{rewardPrice}}
    }
  ],
  "receiverName": "플로우테스트",
  "receiverPhone": "010-1234-5678",
  "shippingAddress": "서울시 강남구",
  "zipCode": "06236",
  "expectedItemsAmount": {{expectedItemsAmount}},
  "expectedTotalAmount": {{expectedTotalAmount}},
  "orderIdempotencyKey": "{{orderIdempotencyKey}}"
}

> {%
    client.test("후원 생성 성공, 결제 완료(PAID)", function() {
        client.assert(response.status === 200, "place order failed: " + response.body);
        client.assert(response.body.data.status === "PAID", "unexpected order status: " + response.body.data.status);
    });
    client.global.set("orderId", response.body.data.id);
%}

### 7. 내 후원 내역 조회
GET {{baseUrl}}/api/v1/orders/me?userId={{userId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("내 후원 내역에 방금 만든 주문 포함", function() {
        client.assert(response.status === 200, "get my orders failed: " + response.body);
        client.assert(response.body.data.length > 0, "no orders found for this user");
    });
%}

### 8. 후원 상세 조회
GET {{baseUrl}}/api/v1/orders/{{orderId}}?userId={{userId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("후원 상세 조회 성공", function() {
        client.assert(response.status === 200, "get order detail failed: " + response.body);
        client.assert(response.body.data.id === client.global.get("orderId"), "order id mismatch");
    });
%}

### 9. 후원 취소 (재고 복원 + 결제 환불(스텁) + 상태 전이)
POST {{baseUrl}}/api/v1/orders/{{orderId}}/cancel?userId={{userId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("후원 취소 성공(CANCELLED)", function() {
        client.assert(response.status === 200, "cancel order failed: " + response.body);
        client.assert(response.body.data.status === "CANCELLED", "unexpected order status: " + response.body.data.status);
    });
%}
