{
  "index": {
    "analysis": {
      "tokenizer": {
        "nori_user_dict": {
          "type": "nori_tokenizer",
          "decompound_mode": "none",
          "user_dictionary": "analysis/userdict_ko.txt"
        }
      },
      "filter": {
        "korean_synonym_graph": {
          "type": "synonym_graph",
          "synonyms_path": "analysis/synonym.txt"
        },
        "korean_pos_stop": {
          "type": "nori_part_of_speech"
        },
        "korean_counter_stop": {
          "type": "nori_part_of_speech",
          "stoptags": ["NNBC"]
        }
      },
      "analyzer": {
        "korean": {
          "type": "custom",
          "tokenizer": "nori_user_dict",
          "filter": ["lowercase", "korean_pos_stop", "korean_counter_stop"]
        },
        "korean_search": {
          "type": "custom",
          "tokenizer": "nori_user_dict",
          "filter": ["lowercase", "korean_synonym_graph"]
        }
      }
    }
  }
}
