# infrastructure/.env 로 복사한 뒤 실제 값을 채운다 (docker compose 가 이 디렉터리에서 .env 를 자동으로 읽는다).
# beadv7_7_earlybird_config(private) 클론용 GitHub 개인 액세스 토큰 — repo scope, 최대 366일.
GIT_USERNAME=
GIT_PERSONAL_ACCESS_TOKEN=

# 9개 서비스가 공유하는 DB 계정 (#164). docker-compose.yml의 mysql 서비스가 정의하는
# MYSQL_USER/MYSQL_PASSWORD와 반드시 같은 값이어야 한다 — 비어있으면 기동 자체가 실패한다.
DB_USERNAME=
DB_PASSWORD=

# board-service 리뷰 생성 알림 메일 발송용 Gmail 계정. 로그인 비밀번호가 아니라
# 2단계 인증을 켠 뒤 발급하는 앱 비밀번호(App Password)를 넣는다.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# user-service(발급)/gateway-server(검증) 공용 JWT 서명 키. 두 서비스 모두 같은 값을 받아야 하며,
# 비어있으면 안 된다(빈 문자열이 그대로 주입되어 서명/검증이 깨진다). 생성 예: openssl rand -base64 32
JWT_SECRET=

# payment-service: PG 구현체 선택(비어있거나 fake면 FakePaymentGateway, toss면 실제 토스 API 호출).
PAYMENT_GATEWAY=
# 토스 시크릿 키 (test_sk_... 또는 live_sk_...). PAYMENT_GATEWAY=toss 일 때만 필요.
PAYMENT_TOSS_SECRET_KEY=
# 결제 민감정보(AES-256-GCM) 암호화 키. Base64로 인코딩한 32바이트 값이어야 하며, 필수값이라
# 비어있으면 payment-service 가 기동 실패한다. 생성 예: openssl rand -base64 32
PAYMENT_SECURITY_ENCRYPTION_KEY=
