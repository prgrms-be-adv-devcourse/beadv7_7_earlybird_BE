{
  "index": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "max_ngram_diff": 20
  },
  "analysis": {
    "tokenizer": {
      "korean_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      },
      "korean_search_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "discard"
      }
    },
    "filter": {
      "product_synonyms": {
        "type": "synonym_graph",
        "synonyms": [
          "노트북, 랩탑, laptop",
          "핸드폰, 휴대폰, 스마트폰",
          "키보드, keyboard",
          "마우스, mouse",
          "이어폰, 이어버드, earphone",
          "무선, 와이어리스, wireless"
        ]
      },
      "autocomplete_edge": {
        "type": "edge_ngram",
        "min_gram": 1,
        "max_gram": 20
      }
    },
    "analyzer": {
      "korean_index":      { "type": "custom", "tokenizer": "korean_tokenizer", "filter": ["lowercase"] },
      "korean_search":     { "type": "custom", "tokenizer": "korean_search_tokenizer", "filter": ["lowercase", "product_synonyms"] },
      "autocomplete_index":{ "type": "custom", "tokenizer": "korean_tokenizer", "filter": ["lowercase", "autocomplete_edge"] }
    }
  }
}
